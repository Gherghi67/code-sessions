#!/usr/bin/env bash
# ABOUTME: Cross-platform secure secrets management for cs sessions
# ABOUTME: Supports macOS Keychain and an encrypted-file/age fallback

set -euo pipefail

SCRIPT_NAME=$(basename "$0")

# Configuration
SECRETS_DIR="${HOME}/.cs-secrets"
# Exported secrets are namespaced so a secret name can never land on a variable
# the shell or the dynamic loader acts on (PATH, PROMPT_COMMAND, LD_PRELOAD and
# friends). Enumerating those names instead was tried and leaked repeatedly.
SECRET_EXPORT_PREFIX="CS_SECRET_"
SALT_FILE="${SECRETS_DIR}/.salt"

# Returns one of: macos | wsl | linux   (cached after first detect)
# detect_backend is the only caller: the keychain exists on macOS and nowhere
# else, so everything but macos falls through to the encrypted file. The value
# keeps three names rather than answering a bare is-macos question because
# CS_PLATFORM_OVERRIDE is how a test on a Mac drives the non-macOS path.
cs_platform() {
    # Test/override seam: FIRST branch, validated, cache-bypassing.
    if [ -n "${CS_PLATFORM_OVERRIDE:-}" ]; then
        case "$CS_PLATFORM_OVERRIDE" in
            macos|wsl|linux) printf '%s' "$CS_PLATFORM_OVERRIDE"; return 0 ;;
            *) printf 'cs: invalid CS_PLATFORM_OVERRIDE: %s\n' "$CS_PLATFORM_OVERRIDE" >&2; return 1 ;;
        esac
    fi
    [ -n "${_CS_PLATFORM:-}" ] && { printf '%s' "$_CS_PLATFORM"; return 0; }
    local p
    case "$(uname -s 2>/dev/null)" in
        Darwin) p=macos ;;
        Linux)
            if [ -n "${WSL_DISTRO_NAME:-}" ] || grep -qiE 'microsoft|wsl' /proc/version 2>/dev/null; then
                p=wsl
            else
                p=linux
            fi ;;
        *) p=linux ;;
    esac
    _CS_PLATFORM="$p"; printf '%s' "$p"
}

usage() {
    cat <<EOF
Usage: $SCRIPT_NAME <command> [options]

Commands:
    set, store <name> [val] Store a secret (prompts if value not provided)
    get <name>              Retrieve a secret value
    list, ls                List all secrets for current session
    delete, rm <name>       Delete a secret
    purge                   Delete ALL secrets for current session
    export                  Export secrets as environment variables (eval-able)
    export-file [FILE]      Export secrets to encrypted file for sync
    import-file [FILE]      Import secrets from encrypted file
    migrate [--redact]      Migrate plaintext secrets from artifact files
    migrate-backend <to>    Migrate secrets to different backend [--from <backend>] [--delete-source]
    backend                 Show which storage backend is being used

Age Commands (public-key encryption for sync):
    age init                Initialize age keypair (auto-downloads age if needed)
    age pubkey              Print your public key for sharing
    age add <file|key>      Add a recipient public key to current session and
                            pin it as trusted on this machine
    age list                List recipients who can decrypt session secrets
    age remove <name>       Remove a recipient from session and unpin it

Options:
    -s, --session <name>    Specify session (default: \$CLAUDE_SESSION_NAME;
                            interactive terminals are offered a session picker)
    -h, --help              Show this help message

Backends (auto-detected, in priority order):
    keychain    macOS Keychain (most secure on macOS)
    encrypted   OpenSSL-encrypted file (cross-platform fallback)

Sync formats (for export-file/import-file):
    age         Public-key encryption (preferred, no shared password)
    enc         AES-256-CBC with shared password (legacy, requires CS_SECRETS_PASSWORD)

Environment:
    CS_SECRETS_BACKEND      Override backend (keychain, encrypted)
    CS_SECRETS_PASSWORD     Master password for encrypted backend (legacy sync)
    CLAUDE_SESSION_NAME     Current session name
    CS_ASSUME_TTY           Treat the terminal as interactive for the session picker

Examples:
    $SCRIPT_NAME store api_key              # Prompts for value (interactive)
    $SCRIPT_NAME store api_key < value-file  # From stdin: keeps the value out of
                                            # argv
    $SCRIPT_NAME get api_key                # Retrieve value
    $SCRIPT_NAME list                       # List all secrets
    eval "\$($SCRIPT_NAME export)"          # Load secrets as CS_SECRET_<NAME> env vars
    $SCRIPT_NAME age init                   # Set up age encryption
    $SCRIPT_NAME age pubkey                 # Get your public key
EOF
    exit 0
}

error() {
    echo "Error: $1" >&2
    exit 1
}

# The sync file's destination, the default one or a path the user named, is
# checked like every session write when it lies in a session: a committed
# link must not carry it out. A path in no session is the user's own choice.
# A directory there would take the file inside it under the temp file's name.
check_export_destination() {  # session, path
    if _cs_refuses_write "cs-secrets export-file" "$2"; then
        exit 1
    fi
    [[ ! -d "$2" ]] || error "Aborting export for session '$1': $2 is a directory"
}

# A write into a session's .cs goes through cs's own writers (cs_mkdir_inside,
# cs_write_atomic), which refuse one a link would carry out of the session; a
# session named with --session gets the same check as the current one. They
# live in cs-shared.sh, beside the hooks once installed, or in a checkout's
# hooks/ when this script runs from one.
load_session_writers() {
    command -v cs_mkdir_inside >/dev/null 2>&1 && return 0
    local lib
    for lib in "$(dirname "$0")/../hooks/cs-shared.sh" "${CS_HOOKS_DIR:-$HOME/.claude/hooks/cs}/cs-shared.sh"; do
        [[ -r "$lib" ]] || continue
        # shellcheck source=../hooks/cs-shared.sh
        . "$lib"
        return 0
    done
    error "Could not load cs-shared.sh (looked beside $SCRIPT_NAME and in ${CS_HOOKS_DIR:-$HOME/.claude/hooks/cs}); reinstall cs"
}

# Exit/return code a backend get uses for a genuinely-absent secret, distinct
# from a real read failure so callers (e.g. the merge-import existence probe)
# never mistake a transient backend error for "missing".
readonly CS_NOT_FOUND=3

secrets_interactive() {
    [[ -t 0 || "${CS_ASSUME_TTY:-}" == "1" ]]
}

# Interactive session picker: numbered list on stderr, choice read from
# stdin. Sets SESSION_NAME on a valid selection; leaves it empty on abort,
# invalid input, or an empty sessions root. stdout never carries picker
# text, so $(cs-secrets get ...) command substitution stays clean.
prompt_session_choice() {
    local sessions_root="${CS_SESSIONS_ROOT:-$HOME/.claude-sessions}"
    local names=() d name
    for d in "$sessions_root"/*/; do
        [[ -d "${d}.cs" ]] || continue
        name=$(basename "$d")
        [[ "$name" == *@* ]] && continue
        [[ -f "${d}.cs/archived" ]] && continue
        names+=("$name")
    done
    # A working directory under the sessions root supplies the default; a
    # worktree dir (<base>@<task>) defaults to its base, which owns the
    # secrets namespace. Archived sessions qualify as defaults even though
    # the list hides them.
    local default_name="" real_pwd="" real_root=""
    real_pwd=$(pwd -P)
    real_root=$(cd "$sessions_root" 2>/dev/null && pwd -P) || real_root=""
    if [[ -n "$real_root" && "$real_pwd" == "$real_root"/* ]]; then
        default_name="${real_pwd#"$real_root"/}"
        default_name="${default_name%%/*}"
        default_name="${default_name%%@*}"
        [[ -d "$sessions_root/$default_name/.cs" ]] || default_name=""
    fi

    if [[ ${#names[@]} -eq 0 && -z "$default_name" ]]; then
        return 0
    fi

    {
        printf 'No session specified. Pick one:\n'
        if [[ ${#names[@]} -gt 0 ]]; then
            local i=1
            for name in "${names[@]}"; do
                printf '  %d) %s\n' "$i" "$name"
                i=$((i + 1))
            done
        fi
        if [[ -n "$default_name" ]]; then
            printf 'Session number [%s]: ' "$default_name"
        else
            printf 'Session number: '
        fi
    } >&2

    local choice=""
    if ! IFS= read -r choice; then
        return 0
    fi
    if [[ -z "$choice" && -n "$default_name" ]]; then
        SESSION_NAME="$default_name"
    elif [[ "$choice" =~ ^[0-9]{1,4}$ ]] \
        && (( 10#$choice >= 1 && 10#$choice <= ${#names[@]} )); then
        SESSION_NAME="${names[$((10#$choice - 1))]}"
    fi
    return 0
}

require_session() {
    if [[ -z "$SESSION_NAME" ]] && secrets_interactive; then
        prompt_session_choice
    fi
    if [[ -z "$SESSION_NAME" ]]; then
        error "No session specified. Set CLAUDE_SESSION_NAME or use --session"
    fi
}

# The age recipients and the sync file live in the session's .cs, and the pin
# list under ~/.cs-secrets is keyed by its name, so the commands that write
# them need a session the sessions root has. A name it lacks (a removed
# session, a mistyped --session) would otherwise be created as a directory
# holding only recipients, with a pin list a later session of that name
# inherits. A session is one entry of the root, so a name that is a path
# (the rule validate_session_ref applies in cs) is refused whatever it leads
# to: ".." would reach the root's parent and ~/.cs-secrets itself.
require_existing_session() {  # name
    local sessions_root="${CS_SESSIONS_ROOT:-$HOME/.claude-sessions}"
    case "$1" in
        ''|.|..|*/*|*\\*) error "No session named '$1' in $sessions_root" ;;
    esac
    [[ -d "$sessions_root/$1/.cs" ]] || error "No session named '$1' in $sessions_root"
}

# Detect operating system and available backend
detect_backend() {
    # Allow explicit override via environment variable
    if [[ -n "${CS_SECRETS_BACKEND:-}" ]]; then
        echo "$CS_SECRETS_BACKEND"
        return
    fi

    # Captured, not substituted inline: a `case "$(cs_platform)"` word discards
    # the exit status, so a rejected CS_PLATFORM_OVERRIDE printed its complaint
    # and then fell through to the encrypted branch -- silently storing secrets
    # somewhere other than the platform the user named.
    local platform
    platform=$(cs_platform) || return 1

    case "$platform" in
        macos)
            if command -v security >/dev/null 2>&1; then
                echo "keychain"
                return
            fi
            ;;
        # wsl/linux: no OS keystore by default -> encrypted below
    esac

    # Fallback to encrypted file (works everywhere with OpenSSL)
    if command -v openssl >/dev/null 2>&1; then
        echo "encrypted"
        return
    fi

    error "No supported secret storage backend found. Install OpenSSL for encrypted file support."
}

BACKEND=$(detect_backend)

# ============================================================================
# KEYCHAIN BACKEND (macOS)
# ============================================================================

keychain_service() {
    local session="$1"
    local name="$2"
    echo "cs:${session}:${name}"
}

# The account name Keychain items are filed under. USER can be unset (cron, a
# systemd unit), and a bare ${USER} would abort the whole expansion under
# `set -u` before `security` ever runs -- which callers cannot distinguish from
# a genuine backend read failure.
keychain_user() {
    local user
    user="${USER:-}"
    [ -n "$user" ] || user=$(id -un 2>/dev/null) || user=""
    printf '%s' "${user:-unknown}"
}

# One word of a `security -i` command line: double-quoted, with the backslash
# and double quote escaped the way that tokenizer reads them. A line break would
# end the command and start another, so a word holding one is refused.
security_word() {
    case "$1" in
        *$'\n'*|*$'\r'*) return 1 ;;
    esac
    local word="${1//\\/\\\\}"
    word="${word//\"/\\\"}"
    printf '"%s"' "$word"
}

keychain_store() {
    local session="$1"
    local name="$2"
    local value="$3"
    local service
    service=$(keychain_service "$session" "$name")

    # The value must not reach argv: `ps` shows any process's arguments to every
    # local user. `security -i` reads its command from stdin instead, and the
    # value travels as -X hex, which stores the same bytes as -w without any
    # quoting. `od -v` keeps repeated 16-byte rows from collapsing into `*`.
    local account_word service_word hex
    if ! account_word=$(security_word "$(keychain_user)") \
        || ! service_word=$(security_word "$service"); then
        echo "Error: a Keychain account or service name holds a line break: $name" >&2
        return 1
    fi
    hex=$(printf '%s' "$value" | od -An -v -tx1 | tr -d ' \n')

    if ! printf 'add-generic-password -a %s -s %s -X "%s" -U\n' "$account_word" "$service_word" "$hex" \
        | security -i >/dev/null 2>&1; then
        # Return rather than exit. Every caller writes `backend_store ... || error`
        # and the migration loop counts failures so it can report an incomplete
        # run; exiting from here made all of that unreachable, and because the
        # migration suppresses this function's stderr, a failed run ended with no
        # diagnostic at all. errexit still makes a bare call fatal for `set`.
        echo "Error: failed to store secret in Keychain: $name" >&2
        return 1
    fi
    echo "Stored secret: $name"
}

keychain_get() {
    local session="$1"
    local name="$2"
    local service
    service=$(keychain_service "$session" "$name")

    # `security find-generic-password` exits 44 (errSecItemNotFound) when the
    # item is genuinely absent; any other nonzero is a real read failure. Map
    # absent to CS_NOT_FOUND and propagate everything else so callers don't
    # treat a transient Keychain error as "missing".
    local value rc=0
    value=$(security find-generic-password -a "$(keychain_user)" -s "$service" -w 2>/dev/null) || rc=$?
    if [[ $rc -eq 0 ]]; then
        echo "$value"
    elif [[ $rc -eq 44 ]]; then
        echo "Error: secret not found: $name" >&2
        return "$CS_NOT_FOUND"
    else
        echo "Error: failed to read secret from Keychain: $name" >&2
        return "$rc"
    fi
}

# Extract stored secret names for a session from a `security dump-keychain`
# blob, one per line. Returns 0 for matches OR a genuinely empty store (grep
# exit 1 = no match); returns nonzero on a real grep error (exit >1) or a sed
# failure, which callers MUST NOT swallow into "no secrets".
keychain_extract_names() {
    local dump="$1" session="$2"
    local matched grc=0
    matched=$(printf '%s\n' "$dump" | grep -o "\"svce\"<blob>=\"cs:${session}:[^\"]*\"") || grc=$?
    [[ $grc -gt 1 ]] && return 1
    [[ -z "$matched" ]] && return 0
    printf '%s\n' "$matched" | sed "s/\"svce\"<blob>=\"cs:${session}://;s/\"$//"
}

keychain_list() {
    local session="$1"

    # Distinguish a real `security` enumeration failure from an empty store:
    # capture the dump and check its exit before filtering (grep no-match =
    # empty store, not a failure).
    local dump
    if ! dump=$(security dump-keychain 2>/dev/null); then
        error "Failed to enumerate Keychain for session: $session"
    fi
    local secrets
    secrets=$(keychain_extract_names "$dump" "$session") \
        || error "Failed to enumerate Keychain for session: $session"

    if [[ -z "$secrets" ]]; then
        echo "No secrets stored for session: $session"
    else
        echo "Secrets for session: $session"
        printf '%s\n' "$secrets" | while IFS= read -r name; do
            [[ -z "$name" ]] && continue
            echo "  - $name"
        done
    fi
}

keychain_delete() {
    local session="$1"
    local name="$2"
    local service
    service=$(keychain_service "$session" "$name")

    if security delete-generic-password -a "$(keychain_user)" -s "$service" >/dev/null 2>&1; then
        echo "Deleted secret: $name"
    else
        error "Secret not found or could not be deleted: $name"
    fi
}

keychain_purge() {
    local session="$1"
    local dump
    if ! dump=$(security dump-keychain 2>/dev/null); then
        error "Failed to enumerate Keychain for session: $session"
    fi
    local secrets
    secrets=$(keychain_extract_names "$dump" "$session") \
        || error "Failed to enumerate Keychain for session: $session"

    if [[ -z "$secrets" ]]; then
        echo "No secrets to purge for session: $session"
        return 0
    fi

    local count=0 failed=0 name service
    while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        service=$(keychain_service "$session" "$name")
        if security delete-generic-password -a "$(keychain_user)" -s "$service" >/dev/null 2>&1; then
            count=$((count + 1))
        else
            failed=$((failed + 1))
        fi
    done <<< "$secrets"

    # A partial purge is a failure, not a smaller count.
    if [[ $failed -gt 0 ]]; then
        echo "Error: purged $count secret(s), but $failed delete(s) failed for session: $session" >&2
        return 1
    fi

    echo "Purged $count secret(s) for session: $session"
}

keychain_export() {
    local session="$1"
    local dump
    if ! dump=$(security dump-keychain 2>/dev/null); then
        error "Failed to enumerate Keychain for session: $session"
    fi
    local secrets
    secrets=$(keychain_extract_names "$dump" "$session") \
        || error "Failed to enumerate Keychain for session: $session"
    [[ -z "$secrets" ]] && return 0

    # Buffer and emit only if EVERY listed credential reads; a per-item read
    # failure aborts nonzero rather than emitting a partial export the caller
    # would eval as the complete set. (Uses a here-string, not a `|`-subshell,
    # so `return` propagates out of the loop.)
    local name service value var_name out="" seen_vars=""
    while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        service=$(keychain_service "$session" "$name")
        if value=$(security find-generic-password -a "$(keychain_user)" -s "$service" -w 2>/dev/null); then
            valid_secret_name "$name" \
                || error "Refusing to export session '$session': stored secret name '$name' is not a valid identifier and would execute when this output is eval'd. Remove it with: cs -secrets delete '$name'"
            var_name=$(secret_export_var "$name")
            # Two stored names can collapse onto one variable (api_key and api-key
            # both give ...API_KEY). Eval would take the last silently, letting one
            # secret shadow another, so refuse rather than emit an ambiguous set.
            case " $seen_vars " in
                *" $var_name "*)
                    error "Refusing to export session '$session': secrets '$name' and an earlier one both export as $var_name. Rename or remove one with: cs -secrets delete '$name'" ;;
            esac
            seen_vars="$seen_vars $var_name"
            out+=$(printf 'export %s=%q' "$var_name" "$value")$'\n'
        else
            echo "Error: failed to read Keychain secret: $name" >&2
            return 1
        fi
    done <<< "$secrets"

    printf '%s' "$out"
}

# ============================================================================
# ENCRYPTED FILE BACKEND (Cross-platform)
# ============================================================================

get_encryption_password() {
    # Priority:
    # 1. Environment variable
    # 2. Derived from machine characteristics + salt

    if [[ -n "${CS_SECRETS_PASSWORD:-}" ]]; then
        echo "$CS_SECRETS_PASSWORD"
        return
    fi

    # Ensure secrets directory and salt exist
    mkdir -p "$SECRETS_DIR"
    chmod 700 "$SECRETS_DIR"

    if [[ ! -f "$SALT_FILE" ]]; then
        # Publish the first-use salt atomically. The naive `openssl rand >
        # SALT_FILE` opens the file EMPTY before openssl fills it, so a
        # concurrent reader can derive its key from an empty salt and write a
        # store that is then permanently undecryptable; two first-use writers
        # could also each persist a different salt. Generate into a temp file,
        # then hard-link it into place: link() fails atomically if the salt
        # already exists (exactly one writer wins), and the salt path transitions
        # from absent to fully-written in one step — never observed half-written.
        # The loser and every later reader read the winner's complete salt below.
        local salt_tmp
        salt_tmp=$(mktemp "${SECRETS_DIR}/.salt.XXXXXX") \
            || error "Failed to create temp file for salt in: $SECRETS_DIR"
        if ! openssl rand -hex 32 > "$salt_tmp"; then
            rm -f "$salt_tmp"
            error "Failed to generate encryption salt"
        fi
        chmod 600 "$salt_tmp"
        ln "$salt_tmp" "$SALT_FILE" 2>/dev/null || true
        rm -f "$salt_tmp"
    fi

    if [[ ! -f "$SALT_FILE" ]]; then
        error "Encryption salt missing after creation attempt: $SALT_FILE"
    fi

    local salt
    salt=$(cat "$SALT_FILE")

    # Derive password from user + hostname + salt
    # This provides machine-specific encryption. USER can be unset (cron, a
    # systemd unit), and a bare ${USER} would abort here under `set -u`.
    # `-` rather than `:-` on purpose: an exported-but-empty USER must keep
    # deriving the password it always did, or that store stops opening. (The
    # sync-filename id uses `:-` instead, where an empty component is the bug.)
    # hostname implementations differ in whether they emit a trailing
    # CR; strip it so the same box derives one password from any shell.
    # This is a key-derivation input, so it is not refactorable on taste: change
    # what bytes reach the digest and every store already encrypted on this
    # machine stops opening, with no fallback derivation and no way back. The
    # failure surfaces at the next `get`, not at the change.
    local host
    host=$(hostname 2>/dev/null) || host=""
    host=${host//$'\r'/}
    local machine_id="${USER-}@${host}"
    echo -n "${machine_id}${salt}" | openssl dgst -sha256 -r | cut -d' ' -f1
}

# Every key of the JSON object on stdin, one per line, CR-free.
#
# The strip enforces an invariant at a trust boundary rather than working around
# a transport: valid_secret_name below constrains a key to [A-Za-z0-9_-], so a CR
# can never belong to a legitimate one, while store and sync files are written by
# other machines and are meant to be hand-editable. A key carrying a stray CR
# reaches a backend as a ghost that no `get` can ever name, and the ghost is far
# more expensive to diagnose than one parameter expansion is to keep.
json_keys() {
    local keys
    keys=$(jq -r 'keys[]') || return 1
    printf '%s' "${keys//$'\r'/}"
}

# A secret name becomes a shell variable name in the eval'd `export` output, so
# it must be an identifier and nothing else. Anything looser lets a name carry
# shell metacharacters that break out of the assignment and execute -- and sync
# files are meant to be committed and shared, so in the worst case the name is
# attacker-controlled. Hyphens are allowed because export maps them to
# underscores.
valid_secret_name() {
    case "$1" in
        ""|*[!A-Za-z0-9_-]*) return 1 ;;
        [!A-Za-z_]*)         return 1 ;;
    esac
    return 0
}

# The variable `cs -secrets export` assigns for a secret name. Hyphen and
# underscore, and the two letter cases, land on one variable, so two different
# names can share it.
secret_export_var() {  # name
    printf '%s%s' "$SECRET_EXPORT_PREFIX" "$(printf '%s' "$1" | tr '[:lower:]-' '[:upper:]_')"
}

# The value at $1 of the JSON object on stdin, byte-exact; empty when absent.
#
# Routed through base64 so a value may carry any byte, including a CR the user
# put there deliberately. The raw `-r` path cannot tell such a CR apart from one
# introduced in transit, so it has no safe rule -- stripping corrupts a real one,
# keeping preserves a spurious one. Base64 retires the question: the only newline
# is the trailing one a command substitution drops anyway.
#
# Do not simplify this away. Removing it is behaviour-neutral for everything the
# suite exercises: mutation-tested, the multi-line round-trip in
# test_cs_secrets.sh still passes with the detour gone, so nothing turns red to
# stop you. That test guards the property (interior newlines survive the value
# path) and by construction cannot referee the mechanism that delivers it.
#
# The `// ""` is load-bearing: `null | @base64` encodes the STRING "null".
json_value() {
    local b64
    b64=$(jq -r --arg k "$1" '.[$k] // "" | @base64') || return 1
    printf '%s' "$b64" | openssl base64 -d -A
}

encrypted_file_path() {
    local session="$1"
    echo "${SECRETS_DIR}/${session}.enc"
}

encrypted_read_store() {
    local session="$1"
    local file
    file=$(encrypted_file_path "$session")

    # No file yet is a legitimate empty store, not a failure.
    if [[ ! -f "$file" ]]; then
        echo "{}"
        return 0
    fi

    local password
    password=$(get_encryption_password)

    # A real decrypt failure (wrong password / corrupt file) MUST NOT masquerade
    # as an empty store: swallowing it into "{}" silently drops every secret on
    # the next write and produces an empty backup. Surface it as a nonzero
    # return so callers abort instead of losing data.
    # The key reaches openssl through an environment variable set for that one
    # command: `pass:` would put it on argv, where `ps` shows it to every local
    # user. env: takes the same bytes as pass:, so existing stores still open.
    local decrypted
    if decrypted=$(CS_SECRETS_KEY="$password" openssl enc -aes-256-cbc -d -pbkdf2 -iter 100000 -in "$file" -pass env:CS_SECRETS_KEY 2>/dev/null); then
        printf '%s\n' "$decrypted"
        return 0
    fi
    echo "Error: failed to decrypt secrets store for session: $session (wrong password or corrupt file)" >&2
    return 1
}

encrypted_write_store() {
    local session="$1"
    local data="$2"
    local file
    file=$(encrypted_file_path "$session")

    mkdir -p "$SECRETS_DIR"
    chmod 700 "$SECRETS_DIR"

    local password
    password=$(get_encryption_password)

    # Transactional write: encrypt into a temp file in the SAME directory (same
    # filesystem, so the rename is atomic), then rename over the live store only
    # on success. This way a disk-full / interrupt / openssl failure / concurrent
    # writer never truncates or partially overwrites the existing ciphertext.
    local dir tmp
    dir=$(dirname "$file")
    tmp=$(mktemp "$dir/.XXXXXX") || {
        echo "Error: failed to create temp file for secrets store: $session" >&2
        return 1
    }
    chmod 600 "$tmp"

    # Key in a one-command environment variable, never on argv (see encrypted_read_store).
    if ! echo "$data" | CS_SECRETS_KEY="$password" openssl enc -aes-256-cbc -e -pbkdf2 -iter 100000 -out "$tmp" -pass env:CS_SECRETS_KEY; then
        rm -f "$tmp"
        echo "Error: failed to encrypt secrets store for session: $session (existing store left intact)" >&2
        return 1
    fi

    # Atomic commit. The rename preserves the temp file's 0600 mode.
    if ! mv "$tmp" "$file"; then
        rm -f "$tmp"
        echo "Error: failed to commit secrets store for session: $session (existing store left intact)" >&2
        return 1
    fi
}

encrypted_lock_path() {
    printf '%s' "${SECRETS_DIR}/.lock.$1"
}

# Atomic per-session mutex around the encrypted store's read-modify-write.
# encrypted_write_store commits atomically, but store/delete READ then WRITE:
# without serialization two writers read the same base and the later commit
# clobbers the earlier writer's change (a lost update). A plain `echo $$ > lock`
# (as the session lock uses) is check-then-act and races; `set -o noclobber` is
# an atomic O_EXCL create, so exactly one concurrent writer wins. Portable to
# bash 3.2 + BSD (no flock). Blocks up to CS_SECRETS_LOCK_TIMEOUT seconds, then
# fails loud rather than racing.
#
# The lock is DELIBERATELY not auto-reaped when its holder PID looks dead. Any
# reaper that renames or removes the live lock path to reclaim it opens a window
# where a second process can acquire the same lock (a re-acquired lock cannot be
# told apart from the stale one without a second serializing lock, which just
# moves the hazard). Since the store/delete signal traps release on every
# catchable signal, a leaked lock means only SIGKILL / power-loss mid
# critical-section — rare — and we fail loud naming the file to remove rather
# than risk handing two writers the lock and silently losing a secret.
encrypted_lock_acquire() {
    mkdir -p "$SECRETS_DIR"
    chmod 700 "$SECRETS_DIR"
    _noclobber_lock_acquire "$(encrypted_lock_path "$1")" "secrets lock for session '$1'"
}

# Release the per-session mutex, but only if this process still owns it: a lock
# reaped as stale and re-acquired by another process must survive this holder's
# release and its signal trap.
encrypted_lock_release() {
    _noclobber_lock_release "$(encrypted_lock_path "$1")"
}

# The O_EXCL mutex behind encrypted_lock_* and age_session_lock_*: one lock
# file, the holder's PID inside, blocking up to CS_SECRETS_LOCK_TIMEOUT
# seconds and then failing loud with the file to remove ("$2" names the lock
# in that message).
_noclobber_lock_acquire() {
    local lock="$1" what="$2"
    local timeout="${CS_SECRETS_LOCK_TIMEOUT:-10}"
    local max_attempts=$(( timeout * 10 ))
    local attempts=0

    # O_EXCL create carrying the holder PID; the redirect fails atomically when
    # the lock already exists, so only the winner writes.
    until ( set -o noclobber; echo "$$" > "$lock" ) 2>/dev/null; do
        if [ "$attempts" -ge "$max_attempts" ]; then
            local holder
            holder=$(cat "$lock" 2>/dev/null || echo "")
            echo "Error: timed out after ${timeout}s acquiring $what (held by PID ${holder:-unknown}). If no such process is running, remove: $lock" >&2
            return 1
        fi
        sleep 0.1 2>/dev/null || sleep 1
        attempts=$(( attempts + 1 ))
    done
}

_noclobber_lock_release() {
    local lock="$1"
    [ -f "$lock" ] || return 0
    local holder
    holder=$(cat "$lock" 2>/dev/null || echo "")
    [ "$holder" = "$$" ] && rm -f "$lock"
    return 0
}

# The machine-local age state for one session (the pin list, the sync-file
# digest record and their mutex) lives OUTSIDE the checkout, under the 0700
# ~/.cs-secrets this tool already owns: a session's .cs/local is gitignored,
# but `git add -f` is not, and a pushed pin list that was read from the
# checkout would have pinned the pusher on a fresh clone. Kept here on every
# backend (the state is shared whatever backend holds the values). Created
# the moment an export of a nonempty store takes its lock, so a keychain or
# password export of a nonempty store now creates ~/.cs-secrets too; the
# narrower guarantee that survives is that an export with nothing to export
# touches nothing (test test_keychain_export_does_not_require_cs_secrets_dir).
# A read-only checkout can still export to an external path.
# Twins: _drop_session_age_state in lib/65-sessions.sh and age_state_dir in
# tui/src/app.rs remove this directory when a base session is removed; the
# three paths change together.
age_state_dir() {
    printf '%s/sessions/%s' "$SECRETS_DIR" "$1"
}

age_state_dir_ensure() {
    mkdir -p "$(age_state_dir "$1")" || return 1
    chmod 700 "$SECRETS_DIR" "$SECRETS_DIR/sessions" "$(age_state_dir "$1")"
}

age_session_lock_path() {
    printf '%s/.age.lock' "$(age_state_dir "$1")"
}

age_session_lock_acquire() {
    age_state_dir_ensure "$1" || return 1
    _noclobber_lock_acquire "$(age_session_lock_path "$1")" "the age recipients lock for session '$1'"
}

age_session_lock_release() {
    _noclobber_lock_release "$(age_session_lock_path "$1")"
}

# `age add` and `age remove` change the recipient set an export snapshots, so
# they take the same per-session lock as the export and hold it to process
# exit (both arms exit from inside the dispatcher, so the EXIT trap releases
# through a global the way export_to_sync_file does).
age_recipients_lock() {
    _CS_EXPORT_LOCK_SESSION="$1"
    trap 'age_session_lock_release "$_CS_EXPORT_LOCK_SESSION"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    age_session_lock_acquire "$1" \
        || error "Refusing to change the age recipients for session '$1': could not acquire the age recipients lock"
}

encrypted_store() {
    local session="$1"
    local name="$2"
    local value="$3"

    # Serialize the whole read-modify-write: the commit is atomic but the
    # read→modify→write sequence is not, so concurrent stores would lose updates
    # without this mutex. Install the cleanup traps BEFORE acquiring: the lock
    # file is created inside encrypted_lock_acquire, so a signal arriving between
    # its creation and the trap install would leak the lock permanently. Release
    # via the EXIT trap; encrypted_lock_release is a no-op until the lock holds
    # this PID, so pre-installing is safe on the failure path too. The signal
    # traps EXIT explicitly (firing the EXIT trap, then terminating) rather than
    # only releasing: bash does not auto-exit after a signal handler returns, so
    # a release-only handler would drop the lock and keep running lock-less
    # through the critical section, letting another writer interleave.
    trap 'encrypted_lock_release "$session"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    encrypted_lock_acquire "$session" \
        || error "Refusing to store: could not acquire secrets lock for session '$session'"

    # If the existing store can't be read, storing now would overwrite it with a
    # fresh single-key object, silently destroying every other secret. Abort.
    local store
    store=$(encrypted_read_store "$session") \
        || error "Refusing to store: existing secrets for session '$session' could not be read (wrong password or corrupt file)"

    local updated
    # The value reaches jq through an environment variable set for that one
    # command, never through --arg, which would put it on argv for `ps` to show.
    updated=$(echo "$store" | CS_SECRETS_VALUE="$value" jq --arg name "$name" '.[$name] = env.CS_SECRETS_VALUE')

    # Errexit does not cover this: callers reach store/delete through
    # `|| error`, which suppresses it for the whole call tree, so an unchecked
    # write would report success having written nothing.
    encrypted_write_store "$session" "$updated" \
        || error "Failed to store secret '$name' for session '$session'"

    encrypted_lock_release "$session"
    trap - EXIT INT TERM HUP
    echo "Stored secret: $name"
}

encrypted_get() {
    local session="$1"
    local name="$2"

    local store
    store=$(encrypted_read_store "$session") \
        || error "Cannot read secrets for session '$session' (wrong password or corrupt file)"

    local value
    value=$(echo "$store" | json_value "$name")

    if [[ -z "$value" ]]; then
        # Store read fine but the key is absent: a genuine not-found, distinct
        # from the read failure handled above.
        echo "Error: secret not found: $name" >&2
        return "$CS_NOT_FOUND"
    fi
    echo "$value"
}

encrypted_list() {
    local session="$1"

    local store
    store=$(encrypted_read_store "$session") \
        || error "Cannot list secrets for session '$session' (wrong password or corrupt file)"

    local keys
    keys=$(echo "$store" | json_keys) \
        || error "Failed to parse secrets store for session: $session"

    if [[ -z "$keys" ]]; then
        echo "No secrets stored for session: $session"
    else
        echo "Secrets for session: $session"
        echo "$keys" | while read -r name; do
            echo "  - $name"
        done
    fi
}

encrypted_delete() {
    local session="$1"
    local name="$2"

    # Same lost-update hazard as encrypted_store: serialize read-modify-write.
    # See encrypted_store for why traps are installed before acquiring and why
    # the signal traps exit rather than only release.
    trap 'encrypted_lock_release "$session"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    encrypted_lock_acquire "$session" \
        || error "Cannot delete secret: could not acquire secrets lock for session '$session'"

    local store
    store=$(encrypted_read_store "$session") \
        || error "Cannot delete secret: store for session '$session' could not be read (wrong password or corrupt file)"

    # Check if key exists
    if ! echo "$store" | jq -e --arg name "$name" 'has($name)' >/dev/null 2>&1; then
        error "Secret not found: $name"
    fi

    local updated
    updated=$(echo "$store" | jq --arg name "$name" 'del(.[$name])')

    # Checked for the same reason encrypted_store checks it.
    encrypted_write_store "$session" "$updated" \
        || error "Failed to delete secret '$name' for session '$session'"

    encrypted_lock_release "$session"
    trap - EXIT INT TERM HUP
    echo "Deleted secret: $name"
}

encrypted_purge() {
    local session="$1"
    local file
    file=$(encrypted_file_path "$session")

    # Hold the same per-session mutex store/delete use, across the whole purge:
    # otherwise a concurrent store that read the store under lock can rename its
    # update into place AFTER this removes the file, resurrecting purged secrets
    # (or the count/existence check races a concurrent commit). Traps installed
    # before acquire, and exiting on signal — see encrypted_store for why.
    trap 'encrypted_lock_release "$session"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    encrypted_lock_acquire "$session" \
        || error "Cannot purge secrets: could not acquire secrets lock for session '$session'"

    if [[ ! -f "$file" ]]; then
        encrypted_lock_release "$session"
        trap - EXIT INT TERM HUP
        echo "No secrets to purge for session: $session"
        return 0
    fi

    # Purge deletes the file regardless, so an unreadable store is tolerated
    # here (only the displayed count is approximate) — unlike the backup path,
    # dropping a corrupt file is the intended destructive outcome.
    local store
    store=$(encrypted_read_store "$session" 2>/dev/null) || store="{}"
    local count
    count=$(echo "$store" | jq 'keys | length' 2>/dev/null || echo "0")

    # The removal is the destructive action — a failure here must not report
    # success (the count above is only cosmetic and stays tolerant).
    rm -f "$file" || error "Failed to remove secrets file for session: $session"

    encrypted_lock_release "$session"
    trap - EXIT INT TERM HUP
    echo "Purged $count secret(s) for session: $session"
}

encrypted_export() {
    local session="$1"

    local store
    store=$(encrypted_read_store "$session") \
        || error "Cannot export secrets for session '$session' (wrong password or corrupt file)"

    # Render the lines here rather than inside jq: the quoting has to match what
    # keychain_export emits, and %q is the shell's own quoter, so both backends
    # produce one eval'd form instead of two dialects that drift apart.
    local name value var_name seen_vars="" out=""
    while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        value=$(echo "$store" | json_value "$name") \
            || error "Failed to format secrets for export for session: $session"
        valid_secret_name "$name" \
            || error "Refusing to export session '$session': stored secret name '$name' is not a valid identifier and would execute when this output is eval'd. Remove it with: cs -secrets delete '$name'"
        var_name=$(secret_export_var "$name")
        # Two stored names can collapse onto one variable (api_key and api-key
        # both give ...API_KEY). Eval would take the last silently, letting one
        # secret shadow another, so refuse rather than emit an ambiguous set.
        case " $seen_vars " in
            *" $var_name "*)
                error "Refusing to export session '$session': secrets '$name' and an earlier one both export as $var_name. Rename or remove one with: cs -secrets delete '$name'" ;;
        esac
        seen_vars="$seen_vars $var_name"
        out+=$(printf 'export %s=%q' "$var_name" "$value")$'\n'
    done <<< "$(echo "$store" | json_keys)"

    # Emit only once every secret has passed. `eval "$(cs -secrets export)"`
    # evaluates whatever reached stdout regardless of the exit status, so a
    # refusal that had already printed some assignments would still apply them.
    printf '%s' "$out"
}


# ============================================================================
# AGE ENCRYPTION (Public-key based sync)
# ============================================================================

AGE_KEY_DIR="${SECRETS_DIR}"
AGE_KEY_FILE="${AGE_KEY_DIR}/age.key"
AGE_PUB_FILE="${AGE_KEY_DIR}/age.pub"
# This machine's ssh-ed25519 key. age encrypts to it and decrypts with it, and
# ssh-keygen signs with it, so one pinned key names both who may read a sync
# file and who wrote it.
MACHINE_KEY_FILE="${AGE_KEY_DIR}/id_ed25519"
MACHINE_PUB_FILE="${AGE_KEY_DIR}/id_ed25519.pub"
AGE_BIN=""  # Set by age_find_binary

# Find age binary (checks PATH and our install location)
age_find_binary() {
    # Override seam, mirroring CLAUDE_CODE_BIN / CS_TMUX_BIN: an explicit path
    # decides the answer outright, so pointing it at something non-executable
    # means "no age on this machine" without having to rebuild PATH.
    if [[ -n "${CS_AGE_BIN:-}" ]]; then
        [[ -x "${CS_AGE_BIN}" ]] || return 1
        AGE_BIN="${CS_AGE_BIN}"
        echo "$AGE_BIN"
        return 0
    fi

    # Check if already found
    if [[ -n "$AGE_BIN" && -x "$AGE_BIN" ]]; then
        echo "$AGE_BIN"
        return 0
    fi

    # Check PATH first
    if command -v age &>/dev/null; then
        AGE_BIN=$(command -v age)
        echo "$AGE_BIN"
        return 0
    fi

    # Check our install location
    if [[ -x "$HOME/.local/bin/age" ]]; then
        AGE_BIN="$HOME/.local/bin/age"
        echo "$AGE_BIN"
        return 0
    fi

    return 1
}

# Check if age is available (without downloading)
age_available() {
    age_find_binary &>/dev/null
}

# Download age binary if not found
# Pinned age release and the SHA-256 of each official tarball
# (github.com/FiloSottile/age/releases). Bump AGE_VERSION and these together.
AGE_VERSION="v1.3.1"
_age_expected_sha() {
    case "$1" in
        darwin-amd64) echo "2b233301ad21ab7b1eabd9ae1198a164005fa4928fcdd745d47c39f8593209d7" ;;
        darwin-arm64) echo "01120ea2cbf0463d4c6bd767f99f3271bbed1cdc8a9aa718a76ba1fe4f01998b" ;;
        linux-amd64)  echo "bdc69c09cbdd6cf8b1f333d372a1f58247b3a33146406333e30c0f26e8f51377" ;;
        linux-arm64)  echo "c6878a324421b69e3e20b00ba17c04bc5c6dab0030cfe55bf8f68fa8d9e9093a" ;;
        linux-arm)    echo "0af5d0dd1664d43dda955938280a668fdd298ad0df90058b409067dfdec74ba3" ;;
        *)            echo "" ;;
    esac
}

# Portable SHA-256 of a file: shasum on BSD/macOS, sha256sum on Linux.
_age_sha256() {
    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    elif command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    else
        echo ""
    fi
}

age_ensure_binary() {
    # Already available?
    if age_find_binary &>/dev/null; then
        return 0
    fi

    echo "age is needed for secure secret sync but was not found." >&2
    echo "age ${AGE_VERSION} will be downloaded from github.com/FiloSottile/age, checksum-verified, and installed to ~/.local/bin/" >&2

    if [[ -t 0 ]]; then
        local response
        read -r -p "Download age? [Y/n] " response </dev/tty
        case "$response" in
            [nN]|[nN][oO])
                echo "Skipped. Install age manually: brew install age" >&2
                return 1
                ;;
        esac
    else
        echo "Non-interactive shell — skipping auto-download. Install age manually." >&2
        return 1
    fi

    # Detect platform
    local os arch url
    case "$(uname -s)" in
        Darwin) os="darwin" ;;
        Linux)  os="linux" ;;
        *)
            echo "Warning: Unsupported OS for age auto-download" >&2
            return 1
            ;;
    esac

    case "$(uname -m)" in
        x86_64|amd64) arch="amd64" ;;
        arm64|aarch64) arch="arm64" ;;
        armv7l) arch="arm" ;;
        *)
            echo "Warning: Unsupported architecture for age auto-download" >&2
            return 1
            ;;
    esac

    local platform="${os}-${arch}"
    local expected_sha
    expected_sha=$(_age_expected_sha "$platform")
    if [[ -z "$expected_sha" ]]; then
        echo "Warning: no pinned age checksum for $platform — refusing unverified download. Install age manually: brew install age" >&2
        return 1
    fi
    url="https://github.com/FiloSottile/age/releases/download/${AGE_VERSION}/age-${AGE_VERSION}-${platform}.tar.gz"

    # Create temp directory for download
    local tmpdir
    tmpdir=$(mktemp -d)
    local tarball="$tmpdir/age.tar.gz"

    # Download to disk, verify the pinned SHA-256, and only then extract. The
    # checksum comes from cs (out of band from the download origin), so a
    # tampered CDN/mirror can't slip in a different binary.
    if ! curl -fsSL --connect-timeout 5 --max-time 120 "$url" -o "$tarball" 2>/dev/null; then
        rm -rf "$tmpdir"
        echo "Warning: Failed to download age. Falling back to encrypted file sync." >&2
        return 1
    fi
    local actual_sha
    actual_sha=$(_age_sha256 "$tarball")
    if [[ -z "$actual_sha" ]]; then
        rm -rf "$tmpdir"
        echo "Warning: no sha256 tool (shasum/sha256sum) to verify age — refusing to install unverified. Install age manually: brew install age" >&2
        return 1
    fi
    if [[ "$actual_sha" != "$expected_sha" ]]; then
        rm -rf "$tmpdir"
        echo "Error: age download checksum mismatch for $platform (expected $expected_sha, got $actual_sha). Aborting install." >&2
        return 1
    fi

    # Verified: extract and install.
    if tar xz -C "$tmpdir" -f "$tarball" 2>/dev/null; then
        mkdir -p "$HOME/.local/bin"

        # Handle both tarball structures (age/ prefix or flat)
        if [[ -f "$tmpdir/age/age" ]]; then
            mv "$tmpdir/age/age" "$HOME/.local/bin/"
            mv "$tmpdir/age/age-keygen" "$HOME/.local/bin/"
        elif [[ -f "$tmpdir/age" ]]; then
            mv "$tmpdir/age" "$HOME/.local/bin/"
            mv "$tmpdir/age-keygen" "$HOME/.local/bin/"
        else
            rm -rf "$tmpdir"
            echo "Warning: Unexpected archive structure" >&2
            return 1
        fi

        chmod +x "$HOME/.local/bin/age" "$HOME/.local/bin/age-keygen"
        rm -rf "$tmpdir"

        AGE_BIN="$HOME/.local/bin/age"
        echo "Installed age to ~/.local/bin/" >&2
        return 0
    else
        rm -rf "$tmpdir"
        echo "Warning: Failed to download age. Falling back to encrypted file sync." >&2
        return 1
    fi
}

# This machine's ssh-ed25519 key pair, created on first use. It has no
# passphrase, since exports run unattended, and it is never one of the user's
# own ~/.ssh keys. A pair is generated aside and linked into place, so a
# second cs racing this one keeps the pair that landed first instead of
# replacing a private key a sync file was already encrypted to.
age_ensure_keypair() {
    # Need age binary first
    if ! age_ensure_binary; then
        return 1
    fi

    if ! command -v ssh-keygen >/dev/null 2>&1; then
        echo "Error: ssh-keygen not found. cs keeps this machine's key as an ssh-ed25519 pair and needs OpenSSH 8.0 or later to create it and to sign with it." >&2
        return 1
    fi

    if [[ -f "$MACHINE_KEY_FILE" ]]; then
        if [[ ! -f "$MACHINE_PUB_FILE" ]]; then
            local derived
            derived=$(mktemp "$AGE_KEY_DIR/.id_ed25519.pub.XXXXXX") || return 1
            if ! ssh-keygen -y -f "$MACHINE_KEY_FILE" > "$derived" </dev/null \
                || ! mv -f "$derived" "$MACHINE_PUB_FILE"; then
                rm -f "$derived"
                echo "Error: could not derive the public key of $MACHINE_KEY_FILE" >&2
                return 1
            fi
        fi
        return 0
    fi

    mkdir -p "$AGE_KEY_DIR"
    chmod 700 "$AGE_KEY_DIR"

    echo "Generating this machine's key..." >&2
    local staging
    staging=$(mktemp -d "$AGE_KEY_DIR/.keygen.XXXXXX") || return 1
    if ! ssh-keygen -q -t ed25519 -N '' -C "$(age_get_machine_id)" -f "$staging/id_ed25519" </dev/null >/dev/null; then
        rm -rf "$staging"
        echo "Error: ssh-keygen could not create a key in $AGE_KEY_DIR" >&2
        return 1
    fi
    chmod 600 "$staging/id_ed25519"
    if ln "$staging/id_ed25519" "$MACHINE_KEY_FILE" 2>/dev/null; then
        mv -f "$staging/id_ed25519.pub" "$MACHINE_PUB_FILE"
        rm -rf "$staging"
        echo "Created this machine's key at $MACHINE_KEY_FILE" >&2
        echo "Public key: $(age_recipient_key "$MACHINE_PUB_FILE")" >&2
        return 0
    fi
    rm -rf "$staging"
    [[ -f "$MACHINE_KEY_FILE" ]] || {
        echo "Error: could not place this machine's key at $MACHINE_KEY_FILE" >&2
        return 1
    }
    age_ensure_keypair
}

# This machine's public key, in the spelling a recipient file holds.
age_get_pubkey() {
    if [[ ! -f "$MACHINE_PUB_FILE" ]]; then
        if ! age_ensure_keypair; then
            return 1
        fi
    fi
    age_recipient_key "$MACHINE_PUB_FILE"
}

# Identifies this machine for per-machine sync filenames. USER can be unset
# (cron, a systemd unit), and settling for an empty ${USER:-} would collapse the
# name to "secrets..enc" -- one filename every machine would then write over, so
# `id -un` answers when the variable cannot. A CR is stripped before it reaches a
# filename whatever produced it: a filename is a poor place to discover a
# non-printing byte, and no legitimate hostname carries one.
age_get_machine_id() {
    local user host
    user="${USER:-}"
    [ -n "$user" ] || user=$(id -un 2>/dev/null) || user=""
    host=$(hostname -s 2>/dev/null || hostname 2>/dev/null) || host=""
    host=${host//$'\r'/}
    printf '%s@%s' "${user:-unknown}" "${host:-unknown}"
}

# Get recipients directory for a session
age_recipients_dir() {
    local session="$1"
    local sessions_root="${CS_SESSIONS_ROOT:-$HOME/.claude-sessions}"
    echo "${sessions_root}/${session}/.cs/age-recipients"
}

# A recipient key in the one spelling cs stores, pins and encrypts to: an
# age1... key as it is, an ssh-ed25519 key as its type and key without the
# comment, so one key has one pin whatever comment a copy of it carries.
# Fails for anything else.
age_canonical_key() {  # key line
    local key_type key_body rest
    case "$1" in
        age1*)
            printf '%s' "$1"
            ;;
        ssh-ed25519\ *)
            read -r key_type key_body rest <<< "$1"
            [[ -n "$key_body" && "$key_body" != *[!A-Za-z0-9+/=]* ]] || return 1
            printf '%s %s' "$key_type" "$key_body"
            ;;
        *)
            return 1
            ;;
    esac
}

# The public key a recipient file holds: its first line, without a CR a file
# committed from another platform may carry, in the canonical spelling when
# it is a key cs knows. Any other line comes back as it is, so the pin check
# names the file.
age_recipient_key() {
    local pubfile="$1" key
    IFS= read -r key < "$pubfile" || [[ -n "$key" ]] || return 1
    key=${key%$'\r'}
    age_canonical_key "$key" || printf '%s' "$key"
}

# One digest naming the whole recipient set, independent of file names and
# order, so an export can tell whether the set changed since it last wrote.
age_recipient_set_digest() {
    local session="$1" recipients_dir pubfile key keys="" digest
    recipients_dir=$(age_recipients_dir "$session")
    for pubfile in "$recipients_dir"/*.pub; do
        [[ -f "$pubfile" ]] || continue
        key=$(age_recipient_key "$pubfile") || continue
        keys+="${key}"$'\n'
    done
    digest=$(printf '%s' "$keys" | LC_ALL=C sort | _age_sha256 -)
    [[ -n "$digest" ]] || return 1
    printf '%s' "$digest"
}

# Machine-local list of the age recipient keys this machine agreed to encrypt
# to, one sha256 of a key per line. .cs/age-recipients/ is tracked, so anyone
# who can push to the session repo can drop a .pub there; a key reaches the
# secrets only once a local `age add` pins it here.
age_trusted_file() {
    echo "$(age_state_dir "$1")/age-trusted"
}

age_key_fingerprint() {
    local fingerprint
    fingerprint=$(printf '%s' "$1" | _age_sha256 -)
    if [[ -z "$fingerprint" ]]; then
        echo "Error: cannot fingerprint an age recipient key: neither shasum nor sha256sum is installed" >&2
        return 1
    fi
    printf '%s' "$fingerprint"
}

age_key_is_pinned() {
    local session="$1" key="$2" trusted fingerprint
    trusted=$(age_trusted_file "$session")
    [[ -f "$trusted" ]] || return 1
    fingerprint=$(age_key_fingerprint "$key") || return 1
    grep -qxF "$fingerprint" "$trusted"
}

age_pin_key() {
    local session="$1" key="$2" trusted fingerprint
    trusted=$(age_trusted_file "$session")
    fingerprint=$(age_key_fingerprint "$key") || return 1
    age_state_dir_ensure "$session" || return 1
    if [[ -f "$trusted" ]] && grep -qxF "$fingerprint" "$trusted"; then
        return 0
    fi
    printf '%s\n' "$fingerprint" >> "$trusted"
}

age_unpin_key() {
    local session="$1" key="$2" trusted fingerprint tmp rc=0
    trusted=$(age_trusted_file "$session")
    [[ -f "$trusted" ]] || return 0
    fingerprint=$(age_key_fingerprint "$key") || return 1
    tmp=$(mktemp "$(dirname "$trusted")/.age-trusted.XXXXXX") || return 1
    # grep -v exits 1 when it removed every line, which is a success here.
    grep -vxF "$fingerprint" "$trusted" > "$tmp" || rc=$?
    if [[ "$rc" -gt 1 ]] || ! mv "$tmp" "$trusted"; then
        rm -f "$tmp"
        return 1
    fi
}

# This machine's own public key is pinned by its content whenever it is a
# recipient: encrypting to a key whose private half lives here admits nobody
# new. Nothing else is ever pinned without an `age add` on this machine. A file
# git can carry is never evidence of trust: an earlier design pinned every
# recipient once when this machine's own sync file already existed, and that
# file has a predictable tracked name, so a push adding a key beside an empty
# secrets.<user>@<host>.age made a fresh clone's first export pin the pusher.
age_pin_own_key() {
    local session="$1" own
    own=$(age_get_pubkey 2>/dev/null) || return 0
    age_canonical_key "$own" >/dev/null || return 0
    age_pin_key "$session" "$own"
}

# The public key of the age key pair this machine used before it had an ssh
# key; nothing when it never had one.
age_earlier_pubkey() {
    local line
    if [[ -f "$AGE_KEY_FILE" ]]; then
        while IFS= read -r line; do
            if [[ "$line" == "# public key: "* ]]; then
                printf '%s' "${line#"# public key: "}"
                return 0
            fi
        done < "$AGE_KEY_FILE"
    fi
    [[ -f "$AGE_PUB_FILE" ]] || return 0
    age_recipient_key "$AGE_PUB_FILE"
}

# Every recipient file that still holds this machine's earlier age key is
# rewritten to its ssh key, which is pinned in the old key's place. The
# recipient set changes with it, so the export that follows re-encrypts, and
# each peer's next export refuses until it pins the new key.
age_switch_own_recipients() {  # session
    local session="$1" earlier own recipients_dir pubfile key switched=()
    earlier=$(age_earlier_pubkey)
    [[ -n "$earlier" ]] || return 0
    recipients_dir=$(age_recipients_dir "$session")
    for pubfile in "$recipients_dir"/*.pub; do
        [[ -f "$pubfile" ]] || continue
        key=$(age_recipient_key "$pubfile") || continue
        [[ "$key" == "$earlier" ]] && switched+=("$pubfile")
    done
    [[ ${#switched[@]} -gt 0 ]] || return 0

    own=$(age_get_pubkey) || return 1
    age_pin_key "$session" "$own" || return 1
    for pubfile in "${switched[@]}"; do
        cs_write_atomic "$pubfile" echo "$own" || return 1
        echo "Switched $(basename "$pubfile") from this machine's age key to its ssh key."
    done
    age_unpin_key "$session" "$earlier" || return 1
    echo "Each other machine sharing this session must pin the new key before its next export:"
    for pubfile in "${switched[@]}"; do
        printf '  cs -secrets --session %q age add %q\n' "$session" "$pubfile"
    done
}

# Refuse when .cs/age-recipients/ holds a key this machine has not pinned,
# naming each file and the command that pins it.
age_check_recipients_pinned() {
    local session="$1" recipients_dir pubfile key unpinned=()
    age_pin_own_key "$session" || {
        echo "Error: could not write the age pin list $(age_trusted_file "$session")" >&2
        return 1
    }
    recipients_dir=$(age_recipients_dir "$session")
    for pubfile in "$recipients_dir"/*.pub; do
        [[ -f "$pubfile" ]] || continue
        key=$(age_recipient_key "$pubfile") || continue
        age_key_is_pinned "$session" "$key" || unpinned+=("$pubfile")
    done
    [[ ${#unpinned[@]} -eq 0 ]] && return 0
    {
        echo "Error: refusing to export secrets for session '$session': these age recipients are not pinned on this machine:"
        for pubfile in "${unpinned[@]}"; do
            echo "  $(basename "$pubfile")"
        done
        echo "A recipient file can arrive with a git pull. If you trust a key, pin it with:"
        for pubfile in "${unpinned[@]}"; do
            printf '  cs -secrets --session %q age add %q\n' "$session" "$pubfile"
        done
        echo "Otherwise delete the file."
    } >&2
    return 1
}

# Machine-local record of the recipient set each age sync file was last
# encrypted to, one "<set digest> <sync file path>" line per file. The
# plaintext-unchanged check alone cannot see a recipient change, and a skipped
# re-encrypt would leave a removed recipient able to read the file.
age_exported_to_file() {
    echo "$(age_state_dir "$1")/age-exported-to"
}

# True when the sync file was last encrypted to the recipient set named by digest.
age_exported_to_matches() {
    local session="$1" output="$2" digest="$3" record line_digest line_path
    record=$(age_exported_to_file "$session")
    [[ -f "$record" ]] || return 1
    while IFS=' ' read -r line_digest line_path; do
        if [[ "$line_path" == "$output" ]]; then
            [[ "$line_digest" == "$digest" ]]
            return
        fi
    done < "$record"
    return 1
}

# Record that the sync file is now encrypted to the recipient set named by digest.
age_exported_to_record() {
    local session="$1" output="$2" digest="$3" record tmp line_digest line_path
    record=$(age_exported_to_file "$session")
    age_state_dir_ensure "$session" || return 1
    tmp=$(mktemp "$(dirname "$record")/.age-exported-to.XXXXXX") || return 1
    if [[ -f "$record" ]]; then
        while IFS=' ' read -r line_digest line_path; do
            [[ "$line_path" == "$output" ]] && continue
            printf '%s %s\n' "$line_digest" "$line_path"
        done < "$record" > "$tmp" || { rm -f "$tmp"; return 1; }
    fi
    printf '%s %s\n' "$digest" "$output" >> "$tmp" || { rm -f "$tmp"; return 1; }
    mv "$tmp" "$record" || { rm -f "$tmp"; return 1; }
}

# Encrypt secrets JSON to age format
age_encrypt_secrets() {
    local session="$1"
    local secrets_json="$2"
    local output="$3"

    local age_bin
    if ! age_bin=$(age_find_binary); then
        return 1
    fi

    local recipients_dir
    recipients_dir=$(age_recipients_dir "$session")

    if [[ ! -d "$recipients_dir" ]] || [[ -z "$(ls -A "$recipients_dir" 2>/dev/null)" ]]; then
        echo "No age recipients configured. Run: cs -secrets age add <pubkey-file>" >&2
        return 1
    fi

    # Build recipient arguments
    local recipient_args=() pubfile key
    for pubfile in "$recipients_dir"/*.pub; do
        [[ -f "$pubfile" ]] || continue
        key=$(age_recipient_key "$pubfile") || continue
        age_key_is_pinned "$session" "$key" || continue
        recipient_args+=(-r "$key")
    done

    if [[ ${#recipient_args[@]} -eq 0 ]]; then
        echo "No valid recipients found" >&2
        return 1
    fi

    # Encrypt
    echo "$secrets_json" | "$age_bin" "${recipient_args[@]}" -o "$output"
}

# Decrypt secrets from age format
age_decrypt_secrets() {
    local input="$1"

    local age_bin
    if ! age_bin=$(age_find_binary); then
        return 1
    fi

    # Every identity this machine holds: a peer encrypts to whichever of its
    # public keys that peer has pinned.
    local identity_args=() identity
    for identity in "$MACHINE_KEY_FILE" "$AGE_KEY_FILE"; do
        [[ -f "$identity" ]] && identity_args+=(-i "$identity")
    done
    if [[ ${#identity_args[@]} -eq 0 ]]; then
        echo "No age identity found at $MACHINE_KEY_FILE or $AGE_KEY_FILE" >&2
        return 1
    fi

    "$age_bin" -d "${identity_args[@]}" < "$input"
}

# ============================================================================
# BACKEND DISPATCH
# ============================================================================

backend_store() {
    case "$BACKEND" in
        keychain)   keychain_store "$@" ;;
        encrypted)  encrypted_store "$@" ;;
        *)          error "Unknown backend: $BACKEND" ;;
    esac
}

backend_get() {
    case "$BACKEND" in
        keychain)   keychain_get "$@" ;;
        encrypted)  encrypted_get "$@" ;;
        *)          error "Unknown backend: $BACKEND" ;;
    esac
}

backend_list() {
    case "$BACKEND" in
        keychain)   keychain_list "$@" ;;
        encrypted)  encrypted_list "$@" ;;
        *)          error "Unknown backend: $BACKEND" ;;
    esac
}

# Every stored secret name for a session, one per line; nothing for an empty
# store. Fails when the backend cannot be read.
backend_names() {  # session
    case "$BACKEND" in
        keychain)
            local dump
            dump=$(security dump-keychain 2>/dev/null) || return 1
            keychain_extract_names "$dump" "$1"
            ;;
        encrypted)
            local store
            store=$(encrypted_read_store "$1") || return 1
            printf '%s\n' "$store" | json_keys
            ;;
        *)          error "Unknown backend: $BACKEND" ;;
    esac
}

backend_delete() {
    case "$BACKEND" in
        keychain)   keychain_delete "$@" ;;
        encrypted)  encrypted_delete "$@" ;;
        *)          error "Unknown backend: $BACKEND" ;;
    esac
}

backend_purge() {
    case "$BACKEND" in
        keychain)   keychain_purge "$@" ;;
        encrypted)  encrypted_purge "$@" ;;
        *)          error "Unknown backend: $BACKEND" ;;
    esac
    # The pins and digest record outlive the session directory (they live
    # under ~/.cs-secrets), so purging a session's secrets drops the trust
    # that went with them: a later session under the same name starts with
    # no pin list.
    rm -rf "$(age_state_dir "$1")"
}

backend_export() {
    case "$BACKEND" in
        keychain)   keychain_export "$@" ;;
        encrypted)  encrypted_export "$@" ;;
        *)          error "Unknown backend: $BACKEND" ;;
    esac
}

# ============================================================================
# SYNC FILE OPERATIONS
# ============================================================================

# Detect sync file format from file path
sync_file_format() {
    local file="$1"
    case "$file" in
        *.age) echo "age" ;;
        *.enc) echo "enc" ;;
        *) echo "unknown" ;;
    esac
}

# Decrypt a single sync file to JSON on stdout. Returns non-zero (without
# exiting) when the file cannot be decrypted with the material available on
# this machine (another machine's age key, a different password), so callers
# can skip files that are not theirs instead of aborting.
decrypt_sync_file() {
    local file="$1"
    local format
    format=$(sync_file_format "$file")

    case "$format" in
        age)
            age_available || return 1
            age_decrypt_secrets "$file" 2>/dev/null || return 1
            ;;
        enc)
            [[ -n "${CS_SECRETS_PASSWORD:-}" ]] || return 1
            # Password in a one-command environment variable, never on argv.
            CS_SECRETS_KEY="$CS_SECRETS_PASSWORD" openssl enc -aes-256-cbc -d -pbkdf2 -iter 100000 \
                -in "$file" -pass env:CS_SECRETS_KEY 2>/dev/null || return 1
            ;;
        *)
            return 1
            ;;
    esac
}

# True when an existing sync file already decrypts to JSON identical to the
# given payload. Every openssl/age run emits fresh ciphertext (random salt /
# ephemeral keys), so byte-comparing the file is meaningless; compare the
# decrypted, canonicalised JSON so export can skip rewrites that change nothing.
sync_file_unchanged() {
    local file="$1"
    local new_json="$2"

    [[ -f "$file" ]] || return 1

    local existing
    existing=$(decrypt_sync_file "$file") || return 1

    local existing_canon new_canon
    existing_canon=$(echo "$existing" | jq -S -c . 2>/dev/null) || return 1
    new_canon=$(echo "$new_json" | jq -S -c . 2>/dev/null) || return 1

    [[ "$existing_canon" == "$new_canon" ]]
}

# The namespace a sync file's signature is made and checked in. It names the
# session, so a file signed for one session does not verify in another.
sync_signature_namespace() {  # session
    printf 'cs-secrets@%s' "$1"
}

# Sign a sync file with this machine's key, writing the signature to a path
# the caller renames into place. age says who may read a sync file; only the
# signature says who wrote it.
sync_sign() {  # file, session, signature output
    ssh-keygen -Y sign -f "$MACHINE_KEY_FILE" -n "$(sync_signature_namespace "$2")" < "$1" > "$3" 2>/dev/null \
        && [[ -s "$3" ]]
}

# The one name every key in an allowed-signers list is filed under: who a
# signer is comes from which recipient file holds its key, not from a name
# the signature carries.
SYNC_SIGNER_PRINCIPAL="cs-secrets"

# True when <file>.sig is a signature over the file, in the session's
# namespace, made by one of the given public keys.
sync_signed_by() {  # file, session, public key...
    local file="$1" session="$2" allowed key rc=0
    shift 2
    [[ -f "$file.sig" && $# -gt 0 ]] || return 1
    allowed=$(mktemp "${TMPDIR:-/tmp}/cs-signers.XXXXXX") || return 1
    for key in "$@"; do
        printf '%s %s\n' "$SYNC_SIGNER_PRINCIPAL" "$key"
    done > "$allowed"
    ssh-keygen -Y verify -f "$allowed" -I "$SYNC_SIGNER_PRINCIPAL" \
        -n "$(sync_signature_namespace "$session")" -s "$file.sig" < "$file" >/dev/null 2>&1 || rc=$?
    rm -f "$allowed"
    return "$rc"
}

# Collect all secrets as JSON from current backend
collect_secrets_json() {
    local session="$1"
    local json="{}"

    # A backup must be all-or-nothing: if enumeration fails, or ANY listed
    # credential fails to read/decode, return nonzero and emit no JSON so the
    # caller aborts rather than writing a partial/empty backup. A genuinely
    # empty store (no creds / no file) returns 0 with "{}".
    case "$BACKEND" in
        keychain)
            local dump
            if ! dump=$(security dump-keychain 2>/dev/null); then
                echo "Error: failed to enumerate Keychain for session: $session" >&2
                return 1
            fi
            local secrets
            # A genuinely empty store (grep no-match) yields empty output and 0;
            # a real grep/sed failure returns nonzero and must abort the backup.
            secrets=$(keychain_extract_names "$dump" "$session") || {
                echo "Error: failed to enumerate Keychain for session: $session" >&2
                return 1
            }
            if [[ -n "$secrets" ]]; then
                while IFS= read -r name; do
                    [[ -z "$name" ]] && continue
                    local service value
                    service=$(keychain_service "$session" "$name")
                    if value=$(security find-generic-password -a "$(keychain_user)" -s "$service" -w 2>/dev/null); then
                        # Value in a one-command environment variable, never on argv.
                        json=$(echo "$json" | CS_SECRETS_VALUE="$value" jq --arg name "$name" '.[$name] = env.CS_SECRETS_VALUE') || return 1
                    else
                        echo "Error: failed to read Keychain secret: $name" >&2
                        return 1
                    fi
                done <<< "$secrets"
            fi
            ;;
        encrypted)
            json=$(encrypted_read_store "$session") || return 1
            ;;
        *)
            error "Unknown backend: $BACKEND"
            ;;
    esac

    echo "$json"
}

# Export secrets to sync file (for git sync)
# Prefers age encryption if available and recipients configured, else falls back to password-encrypted .enc
export_to_sync_file() {
    local session="$1"
    local output="${2:-}"

    require_existing_session "$session"

    # Two mutexes, both released by one EXIT trap through a GLOBAL (export has
    # several early returns, and a function-local would be out of scope when
    # the trap fires at process exit and trip set -u; release is idempotent;
    # signal traps exit, see encrypted_store).
    #
    # 1. The encrypted store's lock, on that backend only. Export is a read
    #    (collect) -> encrypt -> rename transaction; without the mutex a slow
    #    older export can rename a stale snapshot over a newer sync file,
    #    silently losing a secret a concurrent store committed. The keychain
    #    store is atomic per credential (no read-modify-write to lose), and
    #    coupling its export to ~/.cs-secrets would make a keychain machine
    #    need that directory writable (test
    #    test_keychain_export_does_not_require_cs_secrets_dir).
    # 2. The session's age lock under ~/.cs-secrets/sessions/<session>/ (taken
    #    further down, past the empty-store exit), on every backend: the
    #    recipient set, its pin list and the sync-file digest record are
    #    per-session machine-local state. Without it an export that
    #    snapshotted a recipient set can rename a ciphertext still admitting a
    #    removed key over the re-encrypted one while the newer digest stays
    #    recorded, so no later export re-encrypts.
    _CS_EXPORT_LOCK_SESSION="$session"
    trap 'encrypted_lock_release "$_CS_EXPORT_LOCK_SESSION"; age_session_lock_release "$_CS_EXPORT_LOCK_SESSION"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    if [[ "${BACKEND:-}" == "encrypted" ]]; then
        encrypted_lock_acquire "$session" \
            || error "Aborting export for session '$session': could not acquire secrets lock"
    fi

    # Abort before writing anything if the backend can't hand back the complete
    # secret set — a partial/empty sync file would silently lose secrets on the
    # next restore.
    local secrets_json
    secrets_json=$(collect_secrets_json "$session") \
        || error "Aborting export for session '$session': backend ($BACKEND) could not read all secrets; refusing to write a partial backup"

    # Check if there are any secrets
    local count
    count=$(echo "$secrets_json" | jq 'keys | length')
    if [[ "$count" -eq 0 ]]; then
        echo "No secrets to export for session: $session"
        return 0
    fi

    local sessions_root="${CS_SESSIONS_ROOT:-$HOME/.claude-sessions}"
    local meta_dir="${sessions_root}/${session}/.cs"
    load_session_writers
    cs_mkdir_inside "$meta_dir" || exit 1

    # Mutex 2 (see above): held from here, before the recipient set is read
    # or auto-configured, until exit. It lives outside the session, so a
    # read-only checkout can still export to an external path.
    age_session_lock_acquire "$session" \
        || error "Aborting export for session '$session': could not acquire the age recipients lock"

    # Per-machine sync file name. Machines sharing a session over git each write
    # their own file, so concurrent exports never collide into an unmergeable
    # binary conflict that silently drops one side's secrets. Reuses the
    # hostname-derived id already used to name age recipients.
    local machine_id
    machine_id=$(age_get_machine_id)

    # Determine encryption method
    local use_age=false
    local recipients_dir
    recipients_dir=$(age_recipients_dir "$session")

    # Auto-setup age if available but not yet configured for this session
    if age_available; then
        if [[ ! -d "$recipients_dir" ]] || [[ -z "$(ls -A "$recipients_dir" 2>/dev/null)" ]]; then
            # No recipients yet: this machine becomes the first. A key that
            # cannot be made stops the export with the reason; going on would
            # write a password file on a machine that encrypts to keys.
            local keygen_notes
            keygen_notes=$(age_ensure_keypair 2>&1 >/dev/null) || {
                printf '%s\n' "$keygen_notes" >&2
                exit 1
            }
            cs_mkdir_inside "$recipients_dir" || exit 1
            local pubkey
            pubkey=$(age_get_pubkey)
            cs_write_atomic "$recipients_dir/${machine_id}.pub" echo "$pubkey" || exit 1
            age_pin_key "$session" "$pubkey" \
                || error "Could not pin this machine's age key in $(age_trusted_file "$session")"
            echo "Auto-configured age encryption for session (added ${machine_id})"
        fi
    fi

    if age_available && [[ -d "$recipients_dir" ]] && [[ -n "$(ls -A "$recipients_dir" 2>/dev/null)" ]]; then
        use_age=true
    fi

    if [[ "$use_age" == "true" ]]; then
        # Use age encryption
        local age_output="${output:-${meta_dir}/secrets.${machine_id}.age}"
        check_export_destination "$session" "$age_output"

        age_switch_own_recipients "$session" \
            || error "Aborting export for session '$session': could not switch this machine's recipient to its ssh key"

        # Before the unchanged check, so a pulled .pub is reported even when
        # no secret changed. A refusal exits: returning failure would reach the
        # password fallback below and still write a sync file.
        age_check_recipients_pinned "$session" || exit 1

        # Skip only when neither the plaintext nor the recipient set changed:
        # after an `age remove` the plaintext is the same, and keeping the old
        # ciphertext would leave the removed key able to read it. A file whose
        # signature is missing or no longer matches it is written again too:
        # no import accepts it as it is.
        local recipient_digest
        recipient_digest=$(age_recipient_set_digest "$session") \
            || error "Aborting export for session '$session': could not compute the age recipient set digest (no shasum or sha256sum?)"

        local own_key
        own_key=$(age_get_pubkey) \
            || error "Aborting export for session '$session': this machine has no key to sign with"

        if age_exported_to_matches "$session" "$age_output" "$recipient_digest" \
            && sync_file_unchanged "$age_output" "$secrets_json" \
            && sync_signed_by "$age_output" "$session" "$own_key"; then
            echo "No secret changes to export for session: $session ($(basename "$age_output") is up to date)"
            return 0
        fi

        # Atomic write: encrypt into a temp file in the same dir, then rename
        # over the live sync file only on success. Writing straight to
        # "$age_output" would truncate the previous good backup before the new
        # ciphertext is confirmed, losing it on a failed/interrupted encrypt.
        local age_dir age_tmp
        age_dir=$(dirname "$age_output")
        age_tmp=$(mktemp "$age_dir/.secrets.XXXXXX") \
            || error "Failed to create temp file for sync export in: $age_dir"
        if age_encrypt_secrets "$session" "$secrets_json" "$age_tmp"; then
            chmod 600 "$age_tmp"
            # The signature is made before either rename and lands second: a
            # stop between the two leaves a new file beside an old signature,
            # which no import accepts and the next export replaces.
            local sig_tmp
            sig_tmp=$(mktemp "$age_dir/.secrets.sig.XXXXXX") || {
                rm -f "$age_tmp"
                error "Failed to create temp file for the sync export's signature in: $age_dir"
            }
            if ! sync_sign "$age_tmp" "$session" "$sig_tmp"; then
                rm -f "$age_tmp" "$sig_tmp"
                error "Failed to sign the sync export for session '$session' with $MACHINE_KEY_FILE (existing sync file left intact). Signing needs ssh-keygen from OpenSSH 8.0 or later."
            fi
            if ! mv "$age_tmp" "$age_output"; then
                rm -f "$age_tmp" "$sig_tmp"
                error "Failed to commit sync export for session '$session' (existing sync file left intact)"
            fi
            if ! mv "$sig_tmp" "$age_output.sig"; then
                rm -f "$sig_tmp"
                error "Failed to commit the signature of the sync export for session '$session': $age_output is in place without a current signature. Export again."
            fi
            echo "Exported $count secret(s) to: $age_output (age encrypted)"
            if ! age_exported_to_record "$session" "$age_output" "$recipient_digest"; then
                echo "Warning: could not record the recipient set in $(age_exported_to_file "$session"); the next export will re-encrypt again" >&2
            fi

            # Drop this machine's stale password file once it has an age file.
            local old_enc="${meta_dir}/secrets.${machine_id}.enc"
            if [[ -f "$old_enc" ]]; then
                rm -f "$old_enc"
                echo "Removed stale $(basename "$old_enc") (migrated to age)"
            fi
        else
            rm -f "$age_tmp"
            echo "Age encryption failed, falling back to password encryption" >&2
            use_age=false
        fi
    fi

    if [[ "$use_age" == "false" ]]; then
        # Fall back to password-encrypted .enc
        if [[ -z "${CS_SECRETS_PASSWORD:-}" ]]; then
            error "No age recipients configured and CS_SECRETS_PASSWORD not set.
Either:
  1. Set up age encryption: cs -secrets age init && cs -secrets age add ~/.cs-secrets/id_ed25519.pub
  2. Or set CS_SECRETS_PASSWORD for legacy password-based sync"
        fi

        local enc_output="${output:-${meta_dir}/secrets.${machine_id}.enc}"
        check_export_destination "$session" "$enc_output"

        if sync_file_unchanged "$enc_output" "$secrets_json"; then
            echo "No secret changes to export for session: $session ($(basename "$enc_output") is up to date)"
            return 0
        fi

        # Atomic write: encrypt into a temp file in the same dir, then rename
        # over the live sync file only on success. A direct -out "$enc_output"
        # opens (truncates) the previous good backup before openssl finishes, so
        # a failed/interrupted encrypt would leave it destroyed.
        local enc_dir enc_tmp
        enc_dir=$(dirname "$enc_output")
        enc_tmp=$(mktemp "$enc_dir/.secrets.XXXXXX") \
            || error "Failed to create temp file for sync export in: $enc_dir"
        # Password in a one-command environment variable, never on argv.
        if ! echo "$secrets_json" | CS_SECRETS_KEY="$CS_SECRETS_PASSWORD" openssl enc -aes-256-cbc -e -pbkdf2 -iter 100000 \
            -out "$enc_tmp" -pass env:CS_SECRETS_KEY; then
            rm -f "$enc_tmp"
            error "Failed to encrypt sync export for session '$session' (existing sync file left intact)"
        fi
        chmod 600 "$enc_tmp"
        if ! mv "$enc_tmp" "$enc_output"; then
            rm -f "$enc_tmp"
            error "Failed to commit sync export for session '$session' (existing sync file left intact)"
        fi

        echo "Exported $count secret(s) to: $enc_output (password encrypted)"
    fi
}

# Import secrets from sync file(s)
# An explicit path imports just that file. Otherwise every per-machine sync
# file is merged, plus the legacy unsuffixed files (one-shot migration for
# sessions created before per-machine naming). Files that cannot be decrypted
# on this machine are skipped, not fatal.
import_from_sync_file() {
    local session="$1"
    local input="${2:-}"
    local mode="${3:-merge}"  # merge (default) or replace

    require_existing_session "$session"

    local sessions_root="${CS_SESSIONS_ROOT:-$HOME/.claude-sessions}"
    local meta_dir="${sessions_root}/${session}/.cs"

    # Collect candidate sync files.
    local files=()
    if [[ -n "$input" ]]; then
        if [[ ! -f "$input" ]]; then
            echo "No sync file found: $input"
            return 0
        fi
        files=("$input")
    else
        local candidate
        for candidate in \
            "$meta_dir"/secrets.*.age \
            "$meta_dir"/secrets.*.enc \
            "$meta_dir"/secrets.age \
            "$meta_dir"/secrets.enc; do
            [[ -f "$candidate" ]] && files+=("$candidate")
        done
        if [[ ${#files[@]} -eq 0 ]]; then
            echo "No sync file found in: $meta_dir"
            return 0
        fi
    fi

    # Decrypt and union every readable file. Earlier files win key collisions,
    # so per-machine files take precedence over the legacy shared files.
    local merged="{}"
    local sources=0
    local unreadable=0
    local f
    for f in "${files[@]}"; do
        local json
        if ! json=$(decrypt_sync_file "$f"); then
            unreadable=$((unreadable + 1))
            continue
        fi
        if ! echo "$json" | jq empty 2>/dev/null; then
            unreadable=$((unreadable + 1))
            continue
        fi
        # Both stores go to jq on stdin: as --argjson they would put every
        # decrypted value on argv, where `ps` shows it to every local user.
        # `jq empty` above admits a stream of several documents; anything but
        # exactly two would pair the wrong operands, so it fails instead.
        merged=$(printf '%s\n%s\n' "$json" "$merged" \
            | jq -n '[inputs] | if length == 2 then .[0] * .[1] else error("expected one JSON document per sync file") end') \
            || error "Failed to merge sync file: $f"
        sources=$((sources + 1))
    done

    if [[ $sources -eq 0 ]]; then
        # Preserve the explicit-path diagnostics from the single-file era.
        if [[ -n "$input" ]]; then
            local format
            format=$(sync_file_format "$input")
            case "$format" in
                age)
                    age_available || error "age binary not found. Run: cs -secrets age init"
                    error "Failed to decrypt age file. Your key may not be in the recipients list."
                    ;;
                enc)
                    [[ -n "${CS_SECRETS_PASSWORD:-}" ]] || \
                        error "CS_SECRETS_PASSWORD required to decrypt .enc file. Set same password used during export."
                    error "Failed to decrypt sync file. Check CS_SECRETS_PASSWORD."
                    ;;
                *)
                    error "Unknown sync file format: $input"
                    ;;
            esac
        fi
        echo "No decryptable sync files found in: $meta_dir"
        if [[ $unreadable -gt 0 ]]; then
            echo "Skipped $unreadable undecryptable file(s) (need this machine's age key or CS_SECRETS_PASSWORD)."
        fi
        return 0
    fi

    # Every name is judged before any is stored, so a refusal leaves the
    # backend as it was.
    #
    # Names are validated in their JSON spelling, one per line with every
    # control character escaped: a valid name has no escape in it, so a name
    # holding a carriage return or a newline fails as a whole instead of
    # reaching the loops below as a different, shorter name.
    local name var_name seen_vars="" seen_names="" merged_names spelled
    spelled=$(echo "$merged" | jq -r 'keys[] | @json') \
        || error "Aborting import for session '$session': could not read the secret names"
    while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        name=${name#\"}
        name=${name%\"}
        valid_secret_name "$name" \
            || error "Aborting import for session '$session': sync file carries an invalid secret name '$name'. A name must start with a letter or underscore and contain only letters, digits, underscore and hyphen; a name with shell metacharacters would execute when 'cs -secrets export' is eval'd."
    done <<< "$spelled"
    merged_names=$(echo "$merged" | json_keys)
    while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        var_name=$(secret_export_var "$name")
        case " $seen_vars " in
            *" $var_name "*)
                local earlier
                earlier=$(printf '%s\n' "$seen_names" | awk -v v="$var_name" '$1 == v { print $2; exit }')
                error "Aborting import for session '$session': secrets '$earlier' and '$name' both export as $var_name. Nothing was imported. Remove one of them where it is stored, then export and import again." ;;
        esac
        seen_vars="$seen_vars $var_name"
        seen_names="$seen_names"$'\n'"$var_name $name"
    done <<< "$merged_names"
    # A stored secret counts too: merge mode keeps it and replace mode only
    # overwrites the names the sync files carry, so it outlives the import.
    local stored_names
    stored_names=$(backend_names "$session") \
        || error "Aborting import for session '$session': backend ($BACKEND) failed to list the stored secrets"
    while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        case $'\n'"$merged_names"$'\n' in *$'\n'"$name"$'\n'*) continue ;; esac
        var_name=$(secret_export_var "$name")
        case " $seen_vars " in
            *" $var_name "*)
                local incoming
                incoming=$(printf '%s\n' "$seen_names" | awk -v v="$var_name" '$1 == v { print $2; exit }')
                error "Aborting import for session '$session': secrets '$incoming' and '$name' both export as $var_name. Nothing was imported. Remove one of them where it is stored, then export and import again." ;;
        esac
    done <<< "$stored_names"

    # Import the merged secrets into the local backend.
    local imported=0
    local skipped=0
    local key
    while IFS= read -r key; do
        [[ -z "$key" ]] && continue
        local value probe_rc
        value=$(echo "$merged" | json_value "$key")

        # Decide whether to store. In replace mode we always overwrite. In merge
        # mode we store only when the secret is genuinely absent: probe the
        # backend and distinguish CS_NOT_FOUND (safe to store) from a real read
        # failure (must abort, or we would overwrite a secret we merely failed to
        # read). The subshell isolates error()'s exit from this loop.
        local should_store=0
        if [[ "$mode" == "replace" ]]; then
            should_store=1
        elif (backend_get "$session" "$key" >/dev/null 2>&1); then
            : # exists and readable — skip to preserve the local secret
        else
            probe_rc=$?
            if [[ $probe_rc -eq "$CS_NOT_FOUND" ]]; then
                should_store=1
            else
                error "Aborting import for session '$session': backend ($BACKEND) failed to read existing secret '$key' (exit $probe_rc); refusing to overwrite"
            fi
        fi

        if [[ $should_store -eq 1 ]]; then
            backend_store "$session" "$key" "$value" >/dev/null \
                || error "Failed to import secret '$key' into backend ($BACKEND)"
            imported=$((imported + 1))
        else
            skipped=$((skipped + 1))
        fi
    done <<< "$merged_names"

    echo "Imported $imported secret(s) from $sources sync file(s)."
    if [[ $skipped -gt 0 ]]; then
        echo "Skipped $skipped existing secret(s) (use --replace to overwrite)."
    fi
    if [[ $unreadable -gt 0 ]]; then
        echo "Skipped $unreadable undecryptable file(s) (need this machine's age key or CS_SECRETS_PASSWORD)."
    fi
}

# ============================================================================
# MIGRATE COMMAND
# ============================================================================

# Sensitive substrings that mark a key name as holding a secret value.
SENSITIVE_PATTERNS=("key" "secret" "password" "token" "credential" "auth" "apikey" "api_key")

is_sensitive_key() {
    local key="$1"
    local key_lower
    key_lower=$(echo "$key" | tr '[:upper:]' '[:lower:]')

    for pattern in "${SENSITIVE_PATTERNS[@]}"; do
        if [[ "$key_lower" == *"$pattern"* ]]; then
            return 0
        fi
    done
    return 1
}

migrate_secrets() {
    local session="$1"
    local do_redact="$2"
    local sessions_root="${CS_SESSIONS_ROOT:-$HOME/.claude-sessions}"
    local session_dir="$sessions_root/$session"
    local artifacts_dir="$session_dir/.cs/artifacts"

    if [[ ! -d "$artifacts_dir" ]]; then
        echo "No artifacts directory found for session: $session"
        echo "Path checked: $artifacts_dir"
        return 0
    fi

    local migrated=0
    local files_updated=0

    echo "Scanning artifacts for plaintext secrets..."
    echo ""

    # Process each file in artifacts (excluding MANIFEST.json)
    while IFS= read -r -d '' file; do
        local filename
        filename=$(basename "$file")
        [[ "$filename" == "MANIFEST.json" ]] && continue

        local content
        content=$(cat "$file")
        local new_content="$content"
        local file_had_secrets=0

        # Process each line looking for KEY=value or KEY: value patterns
        while IFS= read -r line; do
            # Skip comments and empty lines
            [[ "$line" =~ ^[[:space:]]*# ]] && continue
            [[ -z "${line// /}" ]] && continue

            local key=""
            local value=""

            # Pattern: KEY=value or KEY="value" or KEY='value'
            if [[ "$line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=[[:space:]]*[\"\']?([^\"\']+)[\"\']?[[:space:]]*$ ]]; then
                key="${BASH_REMATCH[1]}"
                value="${BASH_REMATCH[2]}"
            # Pattern: KEY: value
            elif [[ "$line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*:[[:space:]]+(.+)[[:space:]]*$ ]]; then
                key="${BASH_REMATCH[1]}"
                value="${BASH_REMATCH[2]}"
            fi

            [[ -z "$key" ]] && continue
            [[ -z "$value" ]] && continue

            # Skip if already redacted
            [[ "$value" == *"[REDACTED"* ]] && continue

            # Check if this looks like a sensitive key
            if is_sensitive_key "$key"; then
                # Store the secret
                valid_secret_name "$key" \
                    || error "Aborting migration for session '$session': source holds an invalid secret name '$key'. Remove it before migrating."
                backend_store "$session" "$key" "$value" >/dev/null \
                    || error "Failed to store migrated secret: $key"
                echo "  Migrated: $key (from $filename)"
                migrated=$((migrated + 1))
                file_had_secrets=1

                # Prepare redacted version if requested
                if [[ "$do_redact" -eq 1 ]]; then
                    local redacted_value="[REDACTED: stored in keychain as $key]"
                    # Escape special characters for sed
                    local escaped_value
                    escaped_value=$(printf '%s\n' "$value" | sed 's/[[\.*^$()+?{|]/\\&/g')
                    local escaped_redacted
                    escaped_redacted=$(printf '%s\n' "$redacted_value" | sed 's/[[\.*^$()+?{|]/\\&/g')
                    new_content=$(echo "$new_content" | sed "s|$escaped_value|$escaped_redacted|g")
                fi
            fi
        done <<< "$content"

        # Write redacted content back if we made changes
        if [[ "$do_redact" -eq 1 && "$file_had_secrets" -eq 1 ]]; then
            load_session_writers
            cs_write_atomic "$file" echo "$new_content" || exit 1
            files_updated=$((files_updated + 1))
        fi

    done < <(find "$artifacts_dir" -type f -print0)

    echo ""
    if [[ $migrated -eq 0 ]]; then
        echo "No plaintext secrets found to migrate."
    else
        echo "Migrated $migrated secret(s) to secure storage."
        if [[ "$do_redact" -eq 1 ]]; then
            echo "Updated $files_updated file(s) with redacted values."
        else
            echo ""
            echo "Tip: Run with --redact to replace plaintext values with redaction markers."
        fi
    fi
}

# Migrate secrets from one backend to another
migrate_backend() {
    local session="$1"
    local target_backend="$2"
    local delete_source="${3:-false}"
    local source_backend="${4:-$BACKEND}"

    # Validate target backend.
    # across validation, dispatch, and detect_backend.
    case "$target_backend" in
        keychain|encrypted) ;;
        *) error "Invalid target backend: $target_backend. Must be one of: keychain, encrypted" ;;
    esac

    # Validate source backend if specified
    if [[ -n "$4" ]]; then
        case "$source_backend" in
            keychain|encrypted) ;;
            *) error "Invalid source backend: $source_backend. Must be one of: keychain, encrypted" ;;
        esac
    fi

    if [[ "$target_backend" == "$source_backend" ]]; then
        error "Target backend '$target_backend' is the same as source backend"
    fi

    echo "Migrating secrets from '$source_backend' to '$target_backend'..."
    echo ""

    # Temporarily set BACKEND to source for collection
    local original_backend="$BACKEND"
    BACKEND="$source_backend"

    # Collect secrets from source backend as JSON. Abort the migration if the
    # source can't be fully read — migrating a partial set (then optionally
    # purging the source) would lose secrets.
    local secrets_json
    secrets_json=$(collect_secrets_json "$session") || {
        BACKEND="$original_backend"
        error "Aborting migration: source backend '$source_backend' could not read all secrets for session '$session'"
    }

    # Restore original backend
    BACKEND="$original_backend"

    local count
    count=$(echo "$secrets_json" | jq 'keys | length') \
        || error "Failed to parse collected secrets for session: $session"

    if [[ "$count" -eq 0 ]]; then
        echo "No secrets to migrate for session: $session"
        return 0
    fi

    echo "Found $count secret(s) to migrate"

    # Store each secret in target backend
    local migrated=0
    BACKEND="$target_backend"

    while IFS= read -r key; do
        [[ -z "$key" ]] && continue
        local value
        value=$(echo "$secrets_json" | json_value "$key")

        valid_secret_name "$key" \
            || error "Aborting migration for session '$session': source holds an invalid secret name '$key'. Remove it before migrating."
        if backend_store "$session" "$key" "$value" >/dev/null 2>&1; then
            echo "  Migrated: $key"
            migrated=$((migrated + 1))
        else
            echo "  Failed: $key" >&2
        fi
    done <<< "$(echo "$secrets_json" | json_keys)"

    echo ""
    echo "Migrated $migrated of $count secret(s) to $target_backend"

    # Optionally delete from source — only when the migration was complete.
    if [[ "$delete_source" == "true" && $migrated -eq $count ]]; then
        echo ""
        echo "Removing migrated secrets from source backend ($source_backend)..."
        BACKEND="$source_backend"
        # Delete ONLY the keys we migrated, not a blanket purge: a secret stored
        # to the source AFTER our (unlocked) collect snapshot is not in the
        # migrated set, and a blanket purge would delete it without ever
        # migrating it (lost). Per-key delete leaves such a concurrently-added
        # secret intact.
        #
        # The subshell isolates backend_delete's error()/exit: several backends
        # exit nonzero on a not-found key, and a bare `|| true` cannot catch a
        # function's `exit` (it terminates the whole script) — only a subshell
        # boundary can. A key already gone (concurrent delete) is fine: the
        # migration's copy already fully succeeded, so a vanished source key just
        # means the source is already in the desired state. A genuine delete
        # failure leaves the secret in BOTH source and target (duplication, not
        # loss), so warn but do not abort a migration that otherwise succeeded.
        while IFS= read -r key; do
            [[ -z "$key" ]] && continue
            if ! ( backend_delete "$session" "$key" ) >/dev/null 2>&1; then
                echo "  Note: could not remove '$key' from source ($source_backend) — already gone or a backend error; it may remain there" >&2
            fi
        done <<< "$(echo "$secrets_json" | json_keys)"
    elif [[ "$delete_source" == "true" ]]; then
        echo ""
        echo "Skipping source purge - not all secrets migrated successfully" >&2
    fi

    # Restore original backend
    BACKEND="$original_backend"

    # A partial migration must fail loudly so no caller (and no --delete-source
    # decision) treats a lossy migration as success.
    if [[ $migrated -ne $count ]]; then
        error "Migration incomplete: only $migrated of $count secret(s) reached $target_backend"
    fi
}

# ============================================================================
# MAIN
# ============================================================================

# Parse arguments
SESSION_NAME="${CS_SECRETS_SESSION:-${CLAUDE_SESSION_NAME:-}}"
COMMAND=""
AGE_SUBCOMMAND=""
SECRET_NAME=""
SECRET_VALUE=""
DO_REDACT=0
IMPORT_MODE="merge"
DELETE_SOURCE="false"
FROM_BACKEND=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -s|--session)
            SESSION_NAME="$2"
            shift 2
            ;;
        -h|--help)
            usage
            ;;
        age)
            COMMAND="age"
            AGE_SUBCOMMAND="${2:-}"
            # Capture argument after subcommand (e.g., pubkey file or recipient name)
            SECRET_NAME="${3:-}"
            shift
            [[ -n "$AGE_SUBCOMMAND" ]] && shift
            [[ -n "$SECRET_NAME" ]] && shift
            ;;
        set|store|get|list|ls|delete|rm|purge|export|export-file|import-file|migrate|migrate-backend|backend)
            COMMAND="$1"
            shift
            ;;
        --redact)
            DO_REDACT=1
            shift
            ;;
        --replace)
            IMPORT_MODE="replace"
            shift
            ;;
        --delete-source)
            DELETE_SOURCE="true"
            shift
            ;;
        --from)
            FROM_BACKEND="$2"
            shift 2
            ;;
        *)
            if [[ -z "$SECRET_NAME" ]]; then
                SECRET_NAME="$1"
            elif [[ -z "$SECRET_VALUE" ]]; then
                SECRET_VALUE="$1"
            fi
            shift
            ;;
    esac
done

# Handle backend command specially
if [[ "$COMMAND" == "backend" ]]; then
    echo "Storage backend: $BACKEND"
    case "$BACKEND" in
        keychain)   echo "Using macOS Keychain" ;;
        encrypted)  echo "Using OpenSSL-encrypted file (~/.cs-secrets/)" ;;
        *)          error "Unknown backend: $BACKEND" ;;
    esac
    exit 0
fi

# Handle age commands (some don't require session)
if [[ "$COMMAND" == "age" ]]; then
    case "$AGE_SUBCOMMAND" in
        init)
            # Initialize age - no session needed
            if age_ensure_keypair; then
                echo "Age encryption ready."
                echo "Public key: $(age_get_pubkey)"
            else
                exit 1
            fi
            exit 0
            ;;
        pubkey)
            # Get public key - no session needed
            if pubkey=$(age_get_pubkey); then
                echo "$pubkey"
            else
                exit 1
            fi
            exit 0
            ;;
        add)
            # Add recipient - requires session
            require_session
            [[ -z "$SECRET_NAME" ]] && error "Usage: age add <pubkey-file-or-key>"
            require_existing_session "$SESSION_NAME"

            _age_recipients_dir=$(age_recipients_dir "$SESSION_NAME")
            load_session_writers
            cs_mkdir_inside "$_age_recipients_dir" || exit 1

            if [[ -f "$SECRET_NAME" ]]; then
                # It's a file
                _age_pubkey=$(age_recipient_key "$SECRET_NAME") \
                    || error "Invalid public key file (empty): $SECRET_NAME"
                _age_machine_id=$(basename "$SECRET_NAME" .pub)
            else
                # It's a raw public key
                _age_pubkey="$SECRET_NAME"
                _age_machine_id="recipient-$(date +%s)"
            fi

            _age_pubkey=$(age_canonical_key "$_age_pubkey") \
                || error "Invalid public key. Must be a file, an age1... key or a quoted \"ssh-ed25519 <key>\""

            age_recipients_lock "$SESSION_NAME"
            age_pin_own_key "$SESSION_NAME" \
                || error "Could not write the age pin list $(age_trusted_file "$SESSION_NAME")"
            cs_write_atomic "$_age_recipients_dir/${_age_machine_id}.pub" echo "$_age_pubkey" || exit 1
            age_pin_key "$SESSION_NAME" "$_age_pubkey" \
                || error "Could not pin $_age_machine_id in $(age_trusted_file "$SESSION_NAME")"
            echo "Added recipient: $_age_machine_id"
            echo "Public key: $_age_pubkey"
            exit 0
            ;;
        list|ls)
            # List recipients - requires session
            require_session

            _age_recipients_dir=$(age_recipients_dir "$SESSION_NAME")

            if [[ ! -d "$_age_recipients_dir" ]] || [[ -z "$(ls -A "$_age_recipients_dir" 2>/dev/null)" ]]; then
                echo "No recipients configured for session: $SESSION_NAME"
                echo ""
                echo "Add recipients with: cs -secrets age add <pubkey-file>"
                exit 0
            fi

            echo "Recipients for session: $SESSION_NAME"
            for _age_pubfile in "$_age_recipients_dir"/*.pub; do
                [[ -f "$_age_pubfile" ]] || continue
                _age_name=$(basename "$_age_pubfile" .pub)
                _age_key=$(cat "$_age_pubfile")
                echo "  - $_age_name: ${_age_key:0:20}..."
            done
            exit 0
            ;;
        remove|rm)
            # Remove recipient - requires session
            require_session
            [[ -z "$SECRET_NAME" ]] && error "Usage: age remove <recipient-name>"
            require_existing_session "$SESSION_NAME"

            _age_recipients_dir=$(age_recipients_dir "$SESSION_NAME")
            _age_pubfile="$_age_recipients_dir/${SECRET_NAME}.pub"

            if [[ ! -f "$_age_pubfile" ]]; then
                error "Recipient not found: $SECRET_NAME"
            fi

            # Drop the pin too, so the same key pushed back into the directory
            # is refused instead of trusted again.
            age_recipients_lock "$SESSION_NAME"
            if _age_key=$(age_recipient_key "$_age_pubfile"); then
                age_unpin_key "$SESSION_NAME" "$_age_key" \
                    || error "Could not unpin $SECRET_NAME in $(age_trusted_file "$SESSION_NAME")"
            fi
            rm "$_age_pubfile"
            echo "Removed recipient: $SECRET_NAME"
            echo ""
            echo "Note: Existing secrets.age files can still be decrypted by this recipient."
            echo "Run 'cs -secrets export-file' to re-encrypt without this recipient; each machine"
            echo "re-encrypts only its own sync file, and copies in git history stay readable to them."
            exit 0
            ;;
        "")
            error "Usage: age <init|pubkey|add|list|remove>"
            ;;
        *)
            error "Unknown age subcommand: $AGE_SUBCOMMAND"
            ;;
    esac
fi

# Validate session
if [[ -n "$COMMAND" ]]; then
    require_session
fi

# Execute command
case "$COMMAND" in
    store|set)
        [[ -z "$SECRET_NAME" ]] && error "Secret name required"
        if [[ -n "$SECRET_VALUE" ]]; then
            # A value on argv is visible via `ps`. Warn and steer callers to
            # stdin, but still honour it for interactive use.
            echo "Warning: passing the value on the command line exposes it via ps." >&2
            echo "         Prefer stdin: cs -secrets set $SECRET_NAME < valuefile" >&2
        elif [[ -t 0 ]]; then
            # -s: a typed secret must not stay on screen or in scrollback.
            printf "Enter value for %s: " "$SECRET_NAME"
            IFS= read -rs SECRET_VALUE || true
            printf '\n'
        else
            # Non-interactive: take the secret from stdin so it never appears on
            # argv.
            SECRET_VALUE="$(cat)"
        fi
        [[ -z "$SECRET_VALUE" ]] && error "Secret value cannot be empty"
        # A value copied from a redacted transcript or a config template is a
        # mask; storing it would replace a working secret with junk.
        if [[ "$SECRET_VALUE" == '[REDACTED:'* || "$SECRET_VALUE" =~ ^\*+$ \
            || "$SECRET_VALUE" == '<redacted>' || "$SECRET_VALUE" == 'YOUR_API_KEY' ]]; then
            error "Refusing to store $SECRET_NAME: its value '$SECRET_VALUE' is a placeholder, not a secret. Pass the real value on stdin."
        fi
        valid_secret_name "$SECRET_NAME" \
            || error "Refusing to store: invalid secret name '$SECRET_NAME'. A name must start with a letter or underscore and contain only letters, digits, underscore and hyphen, because it becomes a shell variable name in 'cs -secrets export'."
        backend_store "$SESSION_NAME" "$SECRET_NAME" "$SECRET_VALUE"
        ;;
    get)
        [[ -z "$SECRET_NAME" ]] && error "Secret name required"
        backend_get "$SESSION_NAME" "$SECRET_NAME"
        ;;
    list|ls)
        backend_list "$SESSION_NAME"
        ;;
    delete|rm)
        [[ -z "$SECRET_NAME" ]] && error "Secret name required"
        backend_delete "$SESSION_NAME" "$SECRET_NAME"
        ;;
    purge)
        backend_purge "$SESSION_NAME"
        ;;
    export)
        backend_export "$SESSION_NAME"
        ;;
    export-file)
        # SECRET_NAME holds optional file path argument
        export_to_sync_file "$SESSION_NAME" "$SECRET_NAME"
        ;;
    import-file)
        # SECRET_NAME holds optional file path argument
        import_from_sync_file "$SESSION_NAME" "$SECRET_NAME" "$IMPORT_MODE"
        ;;
    migrate)
        migrate_secrets "$SESSION_NAME" "$DO_REDACT"
        ;;
    migrate-backend)
        [[ -z "$SECRET_NAME" ]] && error "Target backend required. Usage: migrate-backend <backend> [--from <backend>] [--delete-source]"
        migrate_backend "$SESSION_NAME" "$SECRET_NAME" "$DELETE_SOURCE" "$FROM_BACKEND"
        ;;
    "")
        usage
        ;;
    *)
        error "Unknown command: $COMMAND"
        ;;
esac
