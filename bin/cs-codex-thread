#!/usr/bin/env python3
# ABOUTME: Creates or refreshes an exact Codex thread, or reads its newest turn or project
# ABOUTME: model settings, without a model.
# ABOUTME: Persists CS context through app-server and verifies it in a fresh process.
# ABOUTME: Also carries a conversation across engines: a thread out as a Claude transcript,
# ABOUTME: a Claude transcript into a new thread. Seeds and checks an encrypted session's vault home.
"""Requires Codex app-server's experimental thread/inject_items API."""

import argparse
from collections import defaultdict
import contextlib
import datetime
import io
import json
import math
import os
from pathlib import Path
import re
import selectors
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import threading
import time
import uuid


class BootstrapError(Exception):
    pass


class DisplayMismatch(BootstrapError):
    """Codex answered the display check, and its rows differ from the ones written."""


# Codex thread IDs are UUIDs. Reject control characters and accidental selectors.
THREAD_ID = re.compile(r"[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}\Z")
# A turn ID is compared, never passed on: any short plain token will do.
TURN_ID = re.compile(r"[0-9A-Za-z_.:-]{1,128}\Z")
MAX_MESSAGE = 4 * 1024 * 1024


class AppServer:
    def __init__(self, executable, cwd, deadline):
        self.deadline = deadline
        self.buffer = b""
        self.counter = 0
        self.max_message = MAX_MESSAGE
        self.selector = selectors.DefaultSelector()
        try:
            self.process = subprocess.Popen(
                [executable, "app-server"], cwd=cwd,
                stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                # Logs can include private configuration; never forward them.
                stderr=subprocess.DEVNULL, bufsize=0, start_new_session=True,
            )
        except OSError as exc:
            self.selector.close()
            raise BootstrapError("could not launch codex app-server") from exc
        os.set_blocking(self.process.stdin.fileno(), False)
        os.set_blocking(self.process.stdout.fileno(), False)
        self.selector.register(self.process.stdout, selectors.EVENT_READ)

    def remaining(self):
        remaining = self.deadline - time.monotonic()
        if remaining <= 0:
            raise BootstrapError("timed out waiting for codex app-server")
        return remaining

    def send(self, message):
        pending = memoryview((json.dumps(message) + "\n").encode("utf-8"))
        self.selector.register(self.process.stdin, selectors.EVENT_WRITE)
        try:
            while pending:
                for key, events in self.selector.select(self.remaining()):
                    if key.fileobj is self.process.stdout:
                        self.read_available()
                    elif events & selectors.EVENT_WRITE:
                        try:
                            count = os.write(self.process.stdin.fileno(), pending)
                        except BlockingIOError:
                            continue
                        pending = pending[count:]
        except OSError as exc:
            raise BootstrapError("codex app-server closed its input") from exc
        finally:
            self.selector.unregister(self.process.stdin)

    def read_available(self):
        try:
            data = os.read(self.process.stdout.fileno(), 65536)
        except BlockingIOError:
            return
        if not data:
            # Its output stays private, but the exit status says something.
            try:
                status = self.process.wait(timeout=1)
            except subprocess.TimeoutExpired:
                status = None
            suffix = " (exit status {})".format(status) if type(status) is int else ""
            raise BootstrapError("codex app-server exited before completing bootstrap" + suffix)
        self.buffer += data
        if len(self.buffer) > self.max_message:
            raise BootstrapError("codex app-server output exceeded the protocol limit")

    def request(self, method, params, *, max_message=MAX_MESSAGE):
        self.max_message = max_message
        try:
            return self._request(method, params)
        finally:
            self.max_message = MAX_MESSAGE

    def _request(self, method, params):
        self.counter += 1
        request_id = "cs-bootstrap-" + str(self.counter)
        self.send({"id": request_id, "method": method, "params": params})
        while True:
            self.remaining()
            while b"\n" in self.buffer:
                line, self.buffer = self.buffer.split(b"\n", 1)
                try:
                    message = json.loads(line)
                except (ValueError, UnicodeError):
                    continue  # Some launchers print diagnostic lines on stdout.
                if not isinstance(message, dict):
                    continue
                if "method" in message:
                    if "id" in message:
                        # Never approve tools, hooks, or authentication requests.
                        raise BootstrapError("codex app-server requested an unsupported interaction")
                    continue
                if message.get("id") != request_id:
                    continue
                if "error" in message:
                    error = message["error"]
                    description = error.get("message") if isinstance(error, dict) else None
                    if isinstance(description, str) and "already has an active writer" in description:
                        raise BootstrapError(
                            "this thread is already open in another Codex process; "
                            "close the existing Codex CLI or desktop session and retry"
                        )
                    code = error.get("code") if isinstance(error, dict) else None
                    suffix = " (code {})".format(code) if type(code) is int else ""
                    raise BootstrapError(
                        "codex app-server rejected " + method + suffix
                        + "; check Codex configuration and experimental API support"
                    )
                result = message.get("result")
                if not isinstance(result, dict):
                    raise BootstrapError("codex app-server returned an invalid " + method + " response")
                return result
            if self.selector.select(self.remaining()):
                self.read_available()

    def initialize(self):
        self.request("initialize", {
            "clientInfo": {"name": "claude_sessions", "version": "1"},
            "capabilities": {"experimentalApi": True},
        })
        self.send({"method": "initialized"})

    def signal_group(self, sig):
        deadline = time.monotonic() + 0.5
        while True:
            try:
                os.killpg(self.process.pid, sig)
                return True
            except ProcessLookupError:
                return False
            except PermissionError:
                # macOS can report EPERM while an exited launcher's group is
                # disappearing. Retry only after the launcher exits, and keep
                # persistent permission failures visible.
                if self.process.poll() is None or time.monotonic() >= deadline:
                    raise
                time.sleep(0.01)

    def close(self):
        self.selector.close()
        self.process.stdin.close()
        try:
            self.process.wait(timeout=1)
        except subprocess.TimeoutExpired:
            pass
        # Terminate the private process group, including children a launcher left.
        for sig in (signal.SIGTERM, signal.SIGKILL):
            if not self.signal_group(sig):
                break
            if sig == signal.SIGTERM:
                try:
                    self.process.wait(timeout=0.5)
                except subprocess.TimeoutExpired:
                    pass
        self.process.wait(timeout=1)
        self.process.stdout.close()

    def __enter__(self):
        return self

    def __exit__(self, *_):
        self.close()


def exact_id(result, expected=None):
    thread = result.get("thread")
    value = thread.get("id") if isinstance(thread, dict) else None
    if not isinstance(value, str) or not THREAD_ID.fullmatch(value):
        raise BootstrapError("codex app-server did not return an exact thread ID")
    if expected is not None and value != expected:
        raise BootstrapError("codex app-server resumed a different thread")
    if thread.get("ephemeral") is True:
        raise BootstrapError("codex app-server returned an ephemeral thread")
    return value


# A plain reopen under the other engine can continue that engine's newer
# conversation (lib/47-transplant.sh). Both native formats are private, so each
# record is checked as it is read and anything unknown is skipped, never fatal.
# What crosses: the user's and the agent's text and every tool call, each tool
# result (and a Codex sub-agent's final answer) cut to its first CLIP
# characters. A command a Codex code-mode script ran crosses as its output,
# before the cut. What stays: Codex's encrypted reasoning and sub-agent
# messages, Claude's thinking, and the context each engine injects for itself.
DEFAULT_CLIP = 4000
# Seconds the zstd command gets to unpack a compressed rollout.
ZSTD_TIMEOUT = 60
# Context Codex adds as user messages: the AGENTS.md text, and items it wraps
# whole in one of these tags (as seen in real rollouts). Other whole-tag items
# are the user's words: a question's reply, a ! command, an automation's
# heartbeat, a prompt pasted in a tag.
CODEX_AGENTS = "# AGENTS.md instructions"
CODEX_CONTEXT = frozenset((
    "environment_context", "user_instructions", "skill", "turn_aborted", "recommended_plugins",
    "guardian_tool_descriptions", "external_codex_apps_open_page", "node_repl_review_evidence"))
TAG_WRAPPED = re.compile(r"\A\s*<([A-Za-z_][\w-]*)>.*</\1>\s*\Z", re.S)
CODEX_FINAL_ANSWER = "Message Type: FINAL_ANSWER\n"
# The keys of exec_command's result, as code mode prints it.
CODEX_COMMAND_RESULT = frozenset((
    "chunk_id", "wall_time_seconds", "exit_code", "session_id", "original_token_count", "output"))
# Code mode's tools, whose output starts with how the script ended, then what it printed.
CODEX_SCRIPT_HEADER = re.compile(r"Script (?:completed|failed|running with cell ID [^\n]*)\nWall time [^\n]*\nOutput:\n\Z")
# exec_command's result head when its command exited with a code other than 0.
CODEX_COMMAND_FAILED = re.compile(r"Chunk ID: [^\n]+\nWall time: [^\n]+\nProcess exited with code [1-9][0-9]*\n")
CODEX_CODE_MODE = frozenset(("exec", "wait"))
CODEX_IMAGES = frozenset(("input_image", "output_image", "image"))
LONE_SURROGATE = re.compile("[\ud800-\udfff]")
SYSTEM_REMINDER = re.compile(r"<system-reminder>.*?</system-reminder>\s*", re.S)
# The opening of a system-reminder tag, either end, which Claude Code defangs in content its
# own tools did not write, as cs does in a carried tool result and user message. Its pattern is JavaScript's,
# so the classes are widened to its \s (which takes U+FEFF) and its ASCII-only \b, kept out
# of re.I's Unicode folds; Python's extra whitespace and the folds in the name only defang more.
REMINDER_TAG = re.compile(r"<(?=[\s\ufeff]*(?:/[\s\ufeff]*)?system-reminder(?-i:(?![A-Za-z0-9_])))", re.I)
LEADING_BLANK_LINES = re.compile(r"\A\s*\n")
COMMAND_NAME = re.compile(r"<command-name>(.*?)</command-name>", re.S)
COMMAND_ARGS = re.compile(r"<command-args>(.*?)</command-args>", re.S)
LOCAL_COMMAND_OUTPUT = ("<local-command-stdout>", "<local-command-stderr>", "<local-command-caveat>")
BACKTICKS = re.compile(r"`+")
# CommonMark's fence lines: an opening one with its info string (a backtick
# fence's holds no backtick), and a closing one, indented up to three spaces.
FENCE_OPEN = re.compile(r"(`{3,}|~{3,})(.*)")
FENCE_CLOSE = re.compile(r" {0,3}(`{3,}|~{3,})[ \t]*\Z")
# CommonMark's line endings.
LINE_ENDING = re.compile(r"\r\n?|\n")
# Levels of a tool input laid out as lines; deeper values cross as JSON, so a
# nested input costs its own size plus at most two spaces a level a line.
READABLE_DEPTH = 32
# A string that, written bare, would read as a JSON number, literal, string,
# object or list, or as a block marker.
NOT_BARE = re.compile(r'(?:-?\d+(?:\.\d+)?(?:[eE][-+]?\d+)?|true|false|null|NaN|-?Infinity|\|[-+]?)\Z|[\[{"]')
# Control characters JSON escapes, but for the tab and the newline a laid-out string keeps.
CONTROL = re.compile(r"[\x00-\x08\x0b-\x1f]")
ENGINE_NAMES = {"claude": "Claude", "codex": "Codex"}
# Claude Code's own label for messages no model produced.
CARRIED_MODEL = "<synthetic>"
# The note carried_note writes, found again at the start of a prompt when a
# carried conversation is carried on. Only the newest note goes with it.
CARRIED_NOTE = re.compile(r"\A\s*\[cs carried this conversation over from [^\]]*\]\s*")
DEFAULT_CLAUDE_VERSION = "2.1.0"
# The oldest Claude Code checked to render a display-only MCP tool, the row it draws for a tool
# it does not have. Without one it draws nothing, so below this only Bash, its own, is a row.
NATIVE_TOOL_ROWS_SINCE = (2, 1, 326)


def open_block(text, closer=None):
    """The line that closes the block text leaves open, starting inside the
    block closer closes: a fence as long as the one that opened it, --> for
    an HTML comment, or None. Only blocks opened at the left margin count: a
    list item's or a quote's block ends at the next line that starts there.
    So an opener indented one to three spaces outside any list is not seen,
    a limit kept: telling it from a list item's would mean following lists."""
    for line in LINE_ENDING.split(text):
        if closer is None:
            opened = FENCE_OPEN.match(line)
            if line.startswith("<!--"):
                closer = None if "-->" in line[4:] else "-->"
            elif opened and not (opened.group(1)[0] == "`" and "`" in opened.group(2)):
                closer = opened.group(1)
        elif closer == "-->":
            if "-->" in line:
                closer = None
        else:
            shut = FENCE_CLOSE.match(line)
            if shut and shut.group(1)[0] == closer[0] and len(shut.group(1)) >= len(closer):
                closer = None
    return closer


class History:
    """User and agent messages in order. One agent message holds everything
    the agent did between two user messages: its text, calls and results."""

    def __init__(self):
        self.messages = []
        # Tool names by call id. A reset keeps them: a compaction replays
        # outputs whose calls came before it.
        self.calls = {}

    def add(self, role, text, timestamp=None, closed=False, tool=None):
        # A closed part is cs's own markdown, every block in it closed. A
        # message is one markdown document, so a block the text before it
        # left open is closed first, or the two would pair up.
        if not isinstance(text, str) or not text.strip():
            return
        last = self.messages[-1] if self.messages else None
        if last is None or last["role"] != role:
            last = {"role": role, "parts": [], "timestamp": timestamp, "closed": 0}
            self.messages.append(last)
        if tool is not None:
            last.setdefault("tools", {})[len(last["parts"])] = tool
        if closed:
            closer = None
            for part in last["parts"][last["closed"]:]:
                closer = open_block(part, closer)
            if closer:
                text = closer + "\n" + text
            last["closed"] = len(last["parts"]) + 1
        last["parts"].append(text)

    def reset(self):
        self.messages = []

    def export(self):
        messages = []
        for m in self.messages:
            message = {"role": m["role"], "text": "\n\n".join(m["parts"]), "timestamp": m["timestamp"]}
            if "tools" in m:
                message.update(parts=m["parts"], tools=m["tools"])
            messages.append(message)
        return messages


def cut_note(text, limit):
    # limit is --clip, which main keeps at one character or more.
    return "\n[cs cut the remaining {:,} characters]".format(len(text) - limit) if len(text) > limit else ""


def trimmed(text):
    # Blank lines around a tool's text go, but not the first line's indent: a fence shows it.
    return LEADING_BLANK_LINES.sub("", text).rstrip()


def history_stats(messages):
    return json.dumps({"messages": len(messages),
                       "characters": sum(len(m["text"]) for m in messages)})


def carried_note(engine, native_id, limit):
    source = ENGINE_NAMES.get(engine, engine)
    kind = "thread" if engine == "codex" else "conversation"
    hidden = "Codex's reasoning is" if engine == "codex" else "Claude's thinking is"
    # Codex's model reads every carried call as text; Claude's reads a call cs
    # can show with its result as a tool call. No "]": CARRIED_NOTE ends at one.
    calls = ("A tool call appears as a tool call where Claude can show it with its result, and as text otherwise"
             if engine == "codex" else "Tool calls and their results appear as text")
    return ("[cs carried this conversation over from {} {} {}. {}, each result cut to its first {:,} characters; "
            "{} not included. Those tools were {}'s: use your own from here on.]").format(
                source, kind, native_id, calls, limit, hidden, source)


def write_private(path, text):
    # Written beside its destination and renamed in, so no reader ever finds
    # half a transcript under the final name.
    path = Path(path)
    fd, temp = tempfile.mkstemp(dir=str(path.parent), prefix="." + path.name + ".")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
        os.replace(temp, str(path))
    except BaseException:
        try:
            os.unlink(temp)
        except OSError:
            pass
        raise


def codex_texts(content):
    if isinstance(content, str):
        return [content]
    texts = []
    for part in content if isinstance(content, list) else []:
        if not isinstance(part, dict):
            continue
        if isinstance(part.get("text"), str):
            texts.append(part["text"])
        elif part.get("type") in CODEX_IMAGES:
            texts.append("[image]")
    return texts


def codex_result_texts(content):
    # A tool result's or a sub-agent answer's text parts, and how many images
    # it held: an image's mark is cs's word, so it follows the fence.
    texts, images = [], 0
    for part in content:
        if not isinstance(part, dict):
            continue
        if isinstance(part.get("text"), str):
            texts.append(part["text"])
        elif part.get("type") in CODEX_IMAGES:
            images += 1
    return texts, images


def codex_injected(text):
    stripped = text.lstrip()
    wrapped = TAG_WRAPPED.match(stripped)
    return stripped.startswith(CODEX_AGENTS) or (wrapped is not None and wrapped.group(1) in CODEX_CONTEXT)


def json_int(value):
    return isinstance(value, int) and not isinstance(value, bool)


def command_status(value):
    """The status of exec_command's result when value is one: its exit code,
    else its session while it still runs, else ""; None for any other value."""
    # Typed as every real result is: a numeric wall time, an integer exit code and session.
    # Other keys, a script's own ({...r, label}) or ones Codex adds later, do not matter.
    if not (isinstance(value, dict) and "chunk_id" in value and isinstance(value.get("output"), str)
            and (json_int(value.get("wall_time_seconds")) or isinstance(value.get("wall_time_seconds"), float))
            and all(value.get(key) is None or json_int(value[key]) for key in ("exit_code", "session_id"))):
        return None
    code, session = value.get("exit_code"), value.get("session_id")
    if code is not None:
        return "exit code {}".format(code)
    if session is not None:
        return "still running in Codex, session {}".format(session)
    return ""


def lifted(value, found, sentinel):
    """value with each command result in it, depth first, appended to found as
    its output and status and replaced by sentinel holding its number there.
    A result with keys exec_command's has not becomes a dict of those keys,
    then "output" holding the sentinel."""
    status = command_status(value)
    if status is not None:
        extra = {key: lifted(item, found, sentinel) for key, item in value.items()
                 if key not in CODEX_COMMAND_RESULT}
        found.append((value["output"], status))
        if not extra:
            return sentinel.format(len(found))
        extra["output"] = sentinel.format(len(found))
        return extra
    if isinstance(value, dict):
        return {key: lifted(item, found, sentinel) for key, item in value.items()}
    if isinstance(value, list):
        return [lifted(item, found, sentinel) for item in value]
    return value


def compact_json(value):
    return json.dumps(value, ensure_ascii=False, separators=(",", ":"))


def unique_keys(pairs):
    # JSON.stringify never repeats a key, so an object that does is printed
    # text. Read whole it keeps only the key's last value: text around a real
    # result could put a forged one in its place. It fails to decode instead.
    value = dict(pairs)
    if len(value) != len(pairs):
        raise ValueError("a repeated key")
    return value


def codex_tool_text(text, found, sentinel):
    # Code mode prints what a script passes to text(), as JSON when it is not
    # a string, each call its own part, so a command run from a script arrives
    # as exec_command's result, its output one escaped string. A part can
    # hold other text too: Codex puts its truncation warning before results
    # printed one a line. A JSON value starting the part or a line in it, and
    # holding results, sends them to found and comes back as (start, end,
    # skeleton): skeleton is the structure around them as compact JSON with
    # sentinel in place of each, or None when the value is one result. The
    # part comes back as those and the text between them, kept as written;
    # with no such value it gives None. JSON holding no result leaves found as
    # it was and stays in the text; a value too deep to walk does too, but the
    # lines inside it are read on their own.
    decoder, pieces, done = json.JSONDecoder(object_pairs_hook=unique_keys), [], 0
    # A value that never closes is read again from each later line: failed decodes share a budget.
    # Once it is spent, a value is decoded within its own line only, where a failure costs that line.
    budget = 2 * len(text)
    at = len(text) - len(text.lstrip())
    while at < len(text):
        if text[at] in "{[":
            start = len(found)
            bounded = budget < 0
            try:
                if bounded:
                    line_end = text.find("\n", at)
                    value, end = decoder.raw_decode(text[at:line_end if line_end >= 0 else len(text)])
                    end += at
                else:
                    value, end = decoder.raw_decode(text, at)
            except (ValueError, RecursionError) as exc:
                end = None
                if not bounded:
                    budget -= (exc.pos if isinstance(exc, json.JSONDecodeError) else len(text)) - at
            if end is not None:
                try:
                    value = lifted(value, found, sentinel)
                    if len(found) > start:
                        if isinstance(value, str):
                            skeleton = None
                        elif isinstance(value, list):
                            # Promise.allSettled's array, say: an entry a line.
                            skeleton = "[" + ",\n ".join(compact_json(item) for item in value) + "]"
                        else:
                            skeleton = compact_json(value)
                        pieces += [text[done:at], (start, len(found), skeleton)]
                        done = end
                    # Nothing inside a value is looked at again.
                    at = end
                except (ValueError, RecursionError):
                    # Too deep to walk: its lines are read on their own, as
                    # after a failed decode, so a result inside still converts.
                    del found[start:]
                    if not bounded:
                        budget -= end - at
        newline = text.find("\n", at)
        if newline < 0:
            break
        at = newline + 1
    if not pieces:
        return None
    return pieces + [text[done:]]


def output_block(number, output, status):
    body = output[:-1] if output.endswith("\n") else output
    head = "[output {}".format(number) + (", " + status if status else "") + ("" if body else ", no output") + "]"
    return head + ("\n" + body if body else "") + "\n"


def codex_script_output(texts):
    """The parts a code-mode script printed, each command result in them
    carried as its output. One result printed on its own, with nothing printed
    after it, crosses as just its output, marked unless it exited 0.
    Otherwise each printed value holding results crosses as its structure's
    skeleton, each result in it a placeholder numbered across the tool
    result, then each output as its own block. Text around those values
    crosses as written. Each result's status comes back too, in number
    order."""
    sentinel = "\x00cs-output-{}-" + uuid.uuid4().hex + "\x00"
    found = []
    parts = [(text, codex_tool_text(text, found, sentinel)) for text in texts]
    single = False
    if len(found) == 1:
        # Text after a bare output, or a bare mark, would read as the command's.
        holding = next(n for n, (_, pieces) in enumerate(parts) if pieces is not None)
        single = not (parts[holding][1][-1] + "".join(text for text, _ in parts[holding + 1:])).strip()
    head, tail = json.dumps(sentinel, ensure_ascii=False).split("{}")
    placed = re.compile(re.escape(head) + r"(\d+)" + re.escape(tail))

    def placeholder(match):
        number = int(match.group(1))
        status = found[number - 1][1]
        return "<output {}".format(number) + (", " + status if status else "") + ">"

    def crossed(start, end, skeleton):
        if single and skeleton is None:
            output, status = found[0]
            if status in ("", "exit code 0"):
                result = output
            else:
                result = "[" + status + "]" + ("\n" + output if output else "")
        else:
            blocks = "\n".join(output_block(number + 1, *found[number]) for number in range(start, end))
            result = blocks if skeleton is None else placed.sub(placeholder, skeleton) + "\n" + blocks
        return result

    return [text if pieces is None else "".join(piece if isinstance(piece, str) else crossed(*piece)
                                                for piece in pieces)
            for text, pieces in parts], [status for _, status in found]


def codex_output(output, code_mode, limit):
    """A tool's output as text, and how many images it held."""
    if isinstance(output, str):
        return output, 0
    if isinstance(output, list):
        texts, images = codex_result_texts(output)
        if code_mode and texts and CODEX_SCRIPT_HEADER.match(texts[0]):
            # A script printing a command's stdout that is itself a result-shaped object is still
            # converted: nothing tells it apart from text(result).
            printed, statuses = codex_script_output(texts[1:])
            text = "\n".join(texts[:1] + printed)
            if len(statuses) > 1 and limit and len(trimmed(text)) > limit:
                # The cut, made on the trimmed text, could hide a later result's head, and its
                # failure: every status comes first.
                index = "[results: " + "; ".join("output {}".format(number) + (", " + status if status else "")
                                                 for number, status in enumerate(statuses, 1)) + "]\n"
                text = "\n".join(texts[:1] + [index] + printed)
            return text, images
        return "\n".join(texts), images
    if isinstance(output, dict) and isinstance(output.get("content"), (str, list)):
        return codex_output(output["content"], code_mode, limit)
    return ("" if output is None else json.dumps(output, ensure_ascii=False)), 0


def codex_function_call(name, arguments):
    # A function call's arguments are a JSON object in a string, laid out as
    # Claude's input is. Arguments that read as no object or list, that
    # repeat a key (the layout would keep one value) or that the layout
    # cannot reach cross as written, under a head that says so: written, they
    # could read as other arguments laid out.
    value = arguments
    if isinstance(arguments, str):
        try:
            value = json.loads(arguments, object_pairs_hook=unique_keys)
        except (ValueError, RecursionError):
            value = None
    if isinstance(value, (dict, list)):
        return tool_call(name, value, arguments if isinstance(arguments, str) else None), value
    return text_call(name, arguments, "arguments as written"), None


def codex_item(history, item, timestamp, limit):
    if not isinstance(item, dict):
        return
    kind = item.get("type")
    if kind in ("function_call", "custom_tool_call") and isinstance(item.get("call_id"), str) \
            and isinstance(item.get("name"), str):
        history.calls[item["call_id"]] = item["name"]
    # Claude Code renders a carried agent message as markdown, so each tool
    # part is closed: a block the agent's text left open ends before it.
    if kind == "message":
        texts = codex_texts(item.get("content"))
        if item.get("role") == "user":
            # A ! command's output is in a user message, so its reminder tags are defanged as a result's are.
            prompts = [REMINDER_TAG.sub("&lt;", CARRIED_NOTE.sub("", t)) for t in texts if not codex_injected(t)]
            history.add("user", "\n\n".join(p for p in prompts if p), timestamp)
        elif item.get("role") == "assistant":
            history.add("assistant", "\n\n".join(texts), timestamp)
        # Developer and system messages are Codex's own instructions.
    elif kind in ("function_call", "custom_tool_call", "local_shell_call"):
        name = item.get("name")
        if kind == "function_call":
            text, args = codex_function_call(name, item.get("arguments"))
        elif kind == "custom_tool_call":
            raw = item.get("input")
            text = text_call(name, raw)
            args = {"input": raw} if isinstance(raw, str) else None
        else:
            name = "shell"
            action = item.get("action")
            args = action if isinstance(action, dict) else {}
            command = args.get("command")
            if isinstance(command, list):
                command = shlex.join(str(word) for word in command)
            text = text_call(name, command if isinstance(command, str) else None)
        history.add("assistant", text, timestamp, closed=True, tool={
            "call": item.get("call_id") or item.get("id"), "name": name, "input": args,
            "namespace": item.get("namespace")})
    elif kind in ("function_call_output", "custom_tool_call_output"):
        # Codex records no failure flag on a call or its output. A failed result says so in its text:
        # code mode's "Script failed" header, or exec_command's "Process exited with code N" with N not 0.
        call_id = item.get("call_id")
        name = history.calls.get(call_id) if isinstance(call_id, str) else None
        code_mode = name in CODEX_CODE_MODE
        output = item.get("output")
        text, images = codex_output(output, code_mode, limit)
        text = trimmed(text)
        failed = False
        if code_mode and isinstance(output, list) and output and isinstance(output[0], dict):
            header = output[0].get("text")
            failed |= isinstance(header, str) and header.startswith("Script failed\n") \
                and bool(CODEX_SCRIPT_HEADER.fullmatch(header))
        if name == "exec_command" and isinstance(output, str):
            failed |= bool(CODEX_COMMAND_FAILED.match(output))
        history.add("assistant", tool_result(text, images, limit, failed), timestamp, closed=True, tool={
            "result": call_id, "failed": failed,
            "output": text[:limit] + cut_note(text, limit) + "\n[image]" * images})
    elif kind == "web_search_call":
        action = item.get("action")
        query = action.get("query") if isinstance(action, dict) else None
        history.add("assistant", text_call("web_search", query if isinstance(query, str) else None), timestamp,
                    closed=True)
    elif kind == "agent_message":
        # A sub-agent's final answer is plain text under a short header. Its
        # other messages hold only that header; their payload is encrypted.
        content = item.get("content") if isinstance(item.get("content"), list) else []
        texts, images = codex_result_texts(content)
        encrypted = any(isinstance(part, dict) and part.get("type") == "encrypted_content" for part in content)
        if texts and texts[0].startswith(CODEX_FINAL_ANSWER) and not encrypted:
            answer = fenced_text("[agent message]", trimmed("\n".join(texts)), limit) + "\n[image]" * images
            history.add("assistant", answer, timestamp, closed=True)
    # Reasoning and the other sub-agent messages (encrypted), tool lists and
    # item kinds not known here stay behind.


def codex_rollout(thread_id):
    # Codex compresses older rollouts to .jsonl.zst. A plain one is the copy
    # Codex still writes to; otherwise the newest wins.
    home = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex")
    found = []
    for folder in ("sessions", "archived_sessions"):
        root = home / folder
        if root.is_dir():
            for suffix in (".jsonl", ".jsonl.zst"):
                found.extend(path for path in root.rglob("rollout-*-" + thread_id + suffix) if path.is_file())
    if not found:
        raise BootstrapError("Codex keeps no saved history for thread " + thread_id)
    return max(found, key=lambda path: (path.suffix == ".jsonl", path.stat().st_mtime))


def queue_rollout_records(path, thread_id, offset=None):
    """Read a bounded snapshot of the running thread, discarding a torn tail.

    From the task's delivery offset when given, else the last 8 MiB."""
    sessions = (Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex") / "sessions").resolve()
    path = Path(path)
    if (not path.is_absolute() or path.is_symlink() or sessions not in path.resolve().parents
            or not path.name.endswith("-" + thread_id + ".jsonl")
            or not path.name.startswith("rollout-")):
        raise BootstrapError("unexpected active rollout path")
    with os.fdopen(os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK), "rb") as handle:
        info = os.fstat(handle.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
            raise BootstrapError("unexpected active rollout file")
        header = json.loads(handle.readline(1024 * 1024))
        if header.get("type") != "session_meta" or header.get("payload", {}).get("id") != thread_id:
            raise BootstrapError("unexpected active rollout session")
        if offset is not None and offset > info.st_size:
            raise BootstrapError("unexpected active rollout size")
        start = max(handle.tell(), info.st_size - 8 * 1024 * 1024 if offset is None else offset)
        if start > handle.tell():
            handle.seek(start - 1)
            if handle.read(1) != b"\n":
                handle.readline(info.st_size - start)
        # Bound reads to the file size sampled at open, even when Codex appends.
        while handle.tell() < info.st_size:
            line = handle.readline(info.st_size - handle.tell())
            if not line.endswith(b"\n"):
                break
            record = json.loads(line)
            if isinstance(record, dict):
                yield record


def queue_usage(record):
    payload = record["payload"]
    usage = payload.get("info") or {}
    latest = (usage.get("last_token_usage") or {}).get("total_tokens")
    window = usage.get("model_context_window")
    # Match the TUI's latest-context calculation and its rounding of percent left.
    context = None
    if type(latest) is int and latest >= 0 and type(window) is int and window > 12000:
        remaining = max(0, window - max(latest, 12000))
        context = 100 - math.floor(remaining * 100 / (window - 12000) + 0.5)
    five_hour = None
    quota = payload.get("rate_limits") or {}
    if quota.get("limit_id") == "codex":
        for key in ("primary", "secondary"):
            bucket = quota.get(key) or {}
            used, resets = bucket.get("used_percent"), bucket.get("resets_at")
            if (bucket.get("window_minutes") == 300 and type(used) in (float, int)
                    and 0 <= used <= 100 and type(resets) is int):
                now = time.time()
                try:
                    stamped = datetime.datetime.fromisoformat(record["timestamp"].replace("Z", "+00:00")).timestamp()
                except (KeyError, ValueError, TypeError, AttributeError, OverflowError):
                    continue
                if resets > now and 0 <= now - stamped <= 1800:
                    five_hour = used
                    break
    return context, five_hour


QUEUE_TOOL_STATUS = re.compile(
    r"\A(?:Chunk ID: [^\n]+\nWall time: [\d.]+ seconds\nProcess exited with code (-?\d+)\n"
    r"|Exit code: (-?\d+)\nWall time: [\d.]+ seconds\n)")


def queue_tool_failed(tool, output):
    if tool not in ("exec_command", "shell_command", "shell", "write_stdin", "apply_patch"):
        return False
    if not isinstance(output, str):
        return False
    status = QUEUE_TOOL_STATUS.match(output)
    if status:
        return int(status[1] or status[2]) != 0
    return tool == "apply_patch" and output.startswith("apply_patch verification failed:")


def queue_snapshot(args):
    delivered = False
    final_assistant = False
    current_turn = False
    calls = {}
    failures = 0
    context, five_hour = None, None
    receipt = re.compile(r'\A<hook_prompt hook_run_id="stop:[^"\n]+">cs task queue \['
                         + re.escape(args.queue_receipt or "") + r'\]:')
    try:
        for record in queue_rollout_records(args.queue_snapshot, args.thread_id, args.queue_offset):
            payload = record.get("payload")
            if not isinstance(payload, dict):
                continue
            kind = payload.get("type")
            if record.get("type") == "event_msg":
                if kind == "task_started":
                    current_turn = payload.get("turn_id") == args.queue_turn
                    delivered, final_assistant, context, five_hour = False, False, None, None
                    calls.clear()
                    failures = 0
                elif kind == "task_complete":
                    current_turn = False
                elif kind == "token_count" and current_turn and (not args.queue_receipt or delivered):
                    # A record without a reading keeps the last valid one.
                    latest_context, latest_five_hour = queue_usage(record)
                    context = context if latest_context is None else latest_context
                    five_hour = five_hour if latest_five_hour is None else latest_five_hour
            if record.get("type") != "response_item":
                continue
            metadata = payload.get("internal_chat_message_metadata_passthrough") or {}
            if metadata.get("turn_id", args.queue_turn if current_turn else None) != args.queue_turn:
                continue
            if not delivered and args.queue_receipt and payload.get("role") == "user":
                for part, info in zip(payload.get("content", []), metadata.get("content_item_metadata", [])):
                    if (info.get("provenance") == {"type": "harness", "hook": True}
                            and receipt.match(part.get("text", ""))):
                        delivered = current_turn = True
                        break
            if not delivered:
                continue
            if payload.get("role") == "assistant" and payload.get("phase") == "final_answer":
                final_assistant = any(part.get("type") == "output_text" and part.get("text")
                                      for part in payload.get("content", []))
            call_id = payload.get("call_id")
            if isinstance(call_id, str):
                if kind in ("function_call", "custom_tool_call"):
                    calls[call_id] = payload.get("name")
                elif kind in ("function_call_output", "custom_tool_call_output"):
                    if queue_tool_failed(calls.pop(call_id, None), payload.get("output")):
                        failures += 1
    except (ValueError, AttributeError, TypeError, OverflowError) as exc:
        raise BootstrapError("unreadable active rollout") from exc
    return json.dumps(dict(delivered=delivered, final_assistant=final_assistant,
                           failures=failures, context=context, five_hour=five_hour))


@contextlib.contextmanager
def open_rollout(path):
    # The rollout is read a line at a time. A compressed one is unpacked as it
    # is read: a few KB of zstd can unpack to gigabytes.
    if path.suffix != ".zst":
        with open(str(path), encoding="utf-8", errors="replace") as handle:
            yield handle
        return
    # Python's own zstd module from 3.14, else the zstd command.
    try:
        from compression import zstd
    except ImportError:
        zstd = None
    command = shutil.which("zstd") if zstd is None else None
    if zstd is None and command is None:
        raise BootstrapError("Codex compressed this thread and no zstd reader is available "
                             "(Python 3.14 or the zstd command)")
    unreadable = "could not read Codex's compressed history of this thread"
    if zstd is not None:
        try:
            with zstd.open(path, "rt", encoding="utf-8", errors="replace") as handle:
                yield handle
        except (zstd.ZstdError, EOFError) as exc:
            raise BootstrapError(unreadable) from exc
        return
    process = subprocess.Popen([command, "-dcq", "--", str(path)], stdin=subprocess.DEVNULL,
                               stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    deadline = threading.Timer(ZSTD_TIMEOUT, process.kill)
    deadline.daemon = True
    deadline.start()
    try:
        with io.TextIOWrapper(process.stdout, encoding="utf-8", errors="replace") as handle:
            yield handle
        process.wait()
    finally:
        deadline.cancel()
        # Reading stopped early: an error or an interrupt.
        if process.poll() is None:
            process.kill()
            process.wait()
    # A damaged copy, or one the deadline cut short.
    if process.returncode != 0:
        raise BootstrapError(unreadable)


def read_codex(path, limit):
    history = History()
    with open_rollout(path) as handle:
        for line in handle:
            try:
                record = json.loads(line)
            except ValueError:
                continue
            if not isinstance(record, dict):
                continue
            item, stamp = record.get("payload"), record.get("timestamp")
            stamp = stamp if isinstance(stamp, str) else None
            if record.get("type") == "compacted" and isinstance(item, dict):
                # A compaction replaces what the model sees from here on: the
                # retained history when Codex kept it, else its summary.
                replacement, summary = item.get("replacement_history"), item.get("message")
                if isinstance(replacement, list):
                    history.reset()
                    for entry in replacement:
                        codex_item(history, entry, stamp, limit)
                elif isinstance(summary, str) and summary.strip():
                    history.reset()
                    # A user message like any other: its reminder tags are defanged.
                    summary = REMINDER_TAG.sub("&lt;", summary)
                    history.add("user", "[Summary of the earlier conversation]\n" + summary, stamp)
            elif record.get("type") == "response_item":
                codex_item(history, item, stamp, limit)
    return history.export()


def claude_blocks(content):
    if isinstance(content, str):
        return [{"type": "text", "text": content}]
    return [block for block in content if isinstance(block, dict)] if isinstance(content, list) else []


def claude_result_text(content):
    # A result's text and how many images it held. Claude Code's reminders
    # ride on tool results; they were never the tool's.
    parts, images = [], 0
    for block in claude_blocks(content):
        if block.get("type") == "text" and isinstance(block.get("text"), str):
            parts.append(trimmed(SYSTEM_REMINDER.sub("", block["text"])))
        elif block.get("type") == "image":
            images += 1
    return "\n".join(part for part in parts if part), images


def fenced(text):
    # Each engine's transcript renders a carried agent message as markdown: a
    # result's "# " lines turn into headings, "- " lines into bullets, and
    # "\\" loses a backslash. A code fence shows its text as written. A fence
    # closes at a run of backticks as long as it, so it outruns every run inside.
    longest = max((len(run) for run in BACKTICKS.findall(text)), default=0)
    fence = "`" * max(3, longest + 1)
    return fence + "\n" + text + "\n" + fence


def fenced_text(head, text, limit=None):
    # A tool part: its head, then its text in a fence, cut to limit when one
    # is given. The cut note is cs's, so it follows the fence.
    if not text:
        return head
    if limit is None:
        return head + "\n" + fenced(text)
    return head + "\n" + fenced(text[:limit]) + cut_note(text, limit)


def tool_head(name, note=None):
    label = name if isinstance(name, str) and name else "tool"
    return "[tool call: " + label + (", " + note if note else "") + "]"


def bare(text):
    # A string that reads as itself on a line: not empty, one line, no edge
    # spaces or control characters, and not another JSON value or a | marker.
    return (text != "" and text == text.strip() and "\n" not in text
            and not CONTROL.search(text) and not NOT_BARE.match(text))


def one_line(value):
    return value if isinstance(value, str) and bare(value) else json.dumps(value, ensure_ascii=False)


def field_name(key):
    # Quoted too when it could pass for a list entry or hold a second "key:".
    return key if bare(key) and ":" not in key and not key.startswith("-") else json.dumps(key, ensure_ascii=False)


def block(text):
    # A string of several lines, written under a | marker: | for one final
    # newline, |- for none and |+ for more, which then show as blank lines.
    if "\n" not in text or not text.strip() or CONTROL.search(text):
        return None
    ends = len(text) - len(text.rstrip("\n"))
    return "|" + ("-" if ends == 0 else "" if ends == 1 else "+"), (text[:-1] if ends else text).split("\n")


def readable_lines(value):
    """A tool input as lines a person reads, and that read back to one input.
    An object has a "key: value" line for each field and a list a "- item"
    line for each entry. A nested value starts under its key or on its dash,
    and a string of several lines under a | marker, indented two spaces. Any
    other string that would not read as itself is quoted as JSON, as are the
    other values and anything nested deeper than READABLE_DEPTH."""
    lines = []

    def nested(item, depth):
        return isinstance(item, (dict, list)) and bool(item) and depth <= READABLE_DEPTH

    def lay_out(container, first, rest, depth):
        # Each line is written once: the first starts with first, the rest with rest.
        if isinstance(container, dict):
            entries = [(field_name(key) + ":", item) for key, item in container.items()]
        else:
            entries = [("-", item) for item in container]
        for index, (head, item) in enumerate(entries):
            prefix = first if index == 0 else rest
            if nested(item, depth + 1):
                # A list entry starts on its dash, a field on the line under its name.
                if head == "-":
                    lay_out(item, prefix + "- ", rest + "  ", depth + 1)
                else:
                    lines.append(prefix + head)
                    lay_out(item, rest + "  ", rest + "  ", depth + 1)
                continue
            several = block(item) if isinstance(item, str) else None
            if several:
                lines.append(prefix + head + " " + several[0])
                lines.extend(rest + "  " + line if line else "" for line in several[1])
            else:
                lines.append(prefix + head + " " + one_line(item))

    if nested(value, 1):
        lay_out(value, "", "", 1)
        return lines
    return [one_line(value)]


def tool_call(name, value, written=None):
    # A tool input that is JSON: Claude's, or a Codex function call's
    # arguments, with written the text they were read from. Written as JSON,
    # a multi-line command or edit shows as one line of literal \n in the
    # other engine's transcript.
    head = tool_head(name)
    if value is None or value in ({}, "", []):
        return head
    try:
        body = "\n".join(readable_lines(value))
    except RecursionError:
        # json.loads read it, so only json.dumps from a deeper stack gets
        # here. Text at hand crosses as written; Claude's input has none.
        if written is not None:
            return text_call(name, written, "arguments as written")
        return head + "\n[cs left out this input: it is nested too deeply to show]"
    return head + "\n" + fenced(body)


def text_call(name, text, note=None):
    # A tool input that is text: a Codex custom tool's (a code mode script,
    # a patch), a shell command, a search. It crosses as written, less the
    # blank lines before it and the whitespace after it; a note goes in the
    # head when there is text.
    if text is None:
        text = ""
    elif not isinstance(text, str):
        text = json.dumps(text, ensure_ascii=False)
    text = trimmed(text)
    return fenced_text(tool_head(name, note if text else None), text)


def tool_result(text, images, limit, failed=False):
    # The image marks are cs's, like the cut note, so they follow the fence.
    return fenced_text("[tool error]" if failed else "[tool result]", text, limit) + "\n[image]" * images


def claude_user_text(text):
    text = CARRIED_NOTE.sub("", SYSTEM_REMINDER.sub("", text).strip())
    if text.startswith(LOCAL_COMMAND_OUTPUT):
        return ""
    name = COMMAND_NAME.search(text)
    if name:
        arguments = COMMAND_ARGS.search(text)
        return (name.group(1).strip() + " " + (arguments.group(1).strip() if arguments else "")).strip()
    return text


def claude_message_id(record):
    message = record.get("message")
    value = message.get("id") if isinstance(message, dict) else None
    return value if isinstance(value, str) else None


def claude_tool_ids(record, kind, key):
    message = record.get("message")
    blocks = claude_blocks(message.get("content")) if isinstance(message, dict) else []
    return {block[key] for block in blocks if block.get("type") == kind and isinstance(block.get(key), str)}


def claude_chain(records):
    # The conversation as Claude Code sends it: from the newest message back
    # through its parents. A rewind's abandoned branch is off this path, and a
    # compaction's boundary has no parent, so the walk starts at its summary.
    by_id, leaf = {}, None
    for record in records:
        record_id = record.get("uuid")
        if not isinstance(record_id, str):
            continue
        by_id[record_id] = record
        if record.get("type") in ("user", "assistant") and not record.get("isSidechain"):
            leaf = record
    chain, seen, node = [], set(), leaf
    while node is not None and node["uuid"] not in seen:
        seen.add(node["uuid"])
        chain.append(node)
        parent = node.get("parentUuid")
        node = by_id.get(parent) if isinstance(parent, str) else None
    chain.reverse()
    # Each block of a reply is its own record. Parallel tool calls hang off
    # one another and each result off its own call, and the reply goes on
    # from the result written last, so the walk passes that result and only
    # the calls before it. The rest of the reply and the results answering
    # its calls go back in, in file order.
    off = [r for r in records if r.get("type") in ("user", "assistant") and not r.get("isSidechain")
           and isinstance(r.get("uuid"), str) and r["uuid"] not in seen]
    replies = {claude_message_id(r) for r in chain if r.get("type") == "assistant"} - {None}
    spliced = [r for r in off if r.get("type") == "assistant" and claude_message_id(r) in replies]
    calls = set()
    for record in chain + spliced:
        calls |= claude_tool_ids(record, "tool_use", "id")
    for record in chain:
        calls -= claude_tool_ids(record, "tool_result", "tool_use_id")
    for record in off:
        answered = claude_tool_ids(record, "tool_result", "tool_use_id") & calls
        if record.get("type") == "user" and answered:
            spliced.append(record)
            calls -= answered
    if not spliced:
        return chain
    keep = {id(record) for record in chain + spliced}
    return [record for record in records if id(record) in keep]


def read_claude(path, limit):
    records = []
    with open(str(path), encoding="utf-8", errors="replace") as handle:
        for line in handle:
            try:
                record = json.loads(line)
            except (ValueError, RecursionError):
                continue
            if isinstance(record, dict):
                records.append(record)
    history = History()
    for record in claude_chain(records):
        message = record.get("message")
        if not isinstance(message, dict) or record.get("isMeta") or record.get("isApiErrorMessage"):
            continue
        stamp = record.get("timestamp")
        stamp = stamp if isinstance(stamp, str) else None
        for block in claude_blocks(message.get("content")):
            kind = block.get("type")
            if record.get("type") == "user":
                if kind == "text" and isinstance(block.get("text"), str):
                    history.add("user", claude_user_text(block["text"]), stamp)
                elif kind == "tool_result":
                    text, images = claude_result_text(block.get("content"))
                    failed = block.get("is_error") is True
                    output = text[:limit] + cut_note(text, limit) + "\n[image]" * images
                    # Claude prefixes failed shell output with its exit code. Read
                    # it before clipping; Codex otherwise displays status 1.
                    exit_status = re.match(r"Exit code ([1-9][0-9]{0,2})(?:\r?\n|$)", text) if failed else None
                    exit_code = int(exit_status[1]) if exit_status else None
                    history.add("assistant", tool_result(text, images, limit, failed), stamp, closed=True,
                                tool={"result": block.get("tool_use_id"), "output": output, "failed": failed,
                                      "exit_code": exit_code})
                elif kind == "image":
                    history.add("user", "[image]", stamp)
            elif record.get("type") == "assistant":
                if kind == "text":
                    history.add("assistant", block.get("text"), stamp)
                elif kind == "tool_use":
                    history.add("assistant", tool_call(block.get("name"), block.get("input")), stamp, closed=True,
                                tool={"call": block.get("id"), "name": block.get("name"), "input": block.get("input"),
                                      "cwd": record.get("cwd")})
                # Thinking is signed for the model that wrote it and stays behind.
    return history.export()


def matched_tools(tools):
    calls, results = defaultdict(list), defaultdict(list)
    for index, tool in tools.items():
        key = tool.get("call") if "call" in tool else tool["result"]
        if isinstance(key, str) and key:
            (calls if "call" in tool else results)[key].append(index)

    # Match only unambiguous pairs within this assistant reply. Missing,
    # duplicate and orphaned parts keep their original position and text.
    for key, indices in calls.items():
        matches = results.get(key, [])
        if len(indices) == len(matches) == 1 and indices[0] < matches[0]:
            yield indices[0], matches[0]


def claude_tool_use(call, cwd, version):
    name, args, namespace = call["name"], call["input"], call["namespace"]
    if not isinstance(name, str) or not isinstance(args, dict) or not native_arguments(args):
        return None
    tool_name = name if name.startswith("mcp__") else "mcp__codex__" + name
    if isinstance(namespace, str) and namespace not in ("", "functions"):
        prefix = namespace if namespace.startswith("mcp__") else "mcp__codex__" + namespace
        tool_name = prefix + "__" + name
    elif name in ("exec_command", "shell", "shell_command"):
        command = args.get("command", args.get("cmd"))
        if isinstance(command, list):
            command = shlex.join(str(word) for word in command)
        if isinstance(command, str) and not ("cmd" in args and "command" in args):
            # Claude's Bash input is a strict object; Codex's execution options
            # stay behind, and a directory other than the session's goes into the command.
            directory = args.get("workdir", args.get("working_directory"))
            if isinstance(directory, str) and directory and os.path.normpath(directory) != os.path.normpath(cwd):
                command = "cd " + shlex.quote(directory) + " && " + command
            args = {"command": command}
            tool_name = "Bash"
    if not re.fullmatch(r"[A-Za-z0-9_-]{1,128}", tool_name):
        return None
    leading = re.match(r"(\d+)\.(\d+)\.(\d+)", version or "")
    if tool_name != "Bash" and not (leading and tuple(map(int, leading.groups())) >= NATIVE_TOOL_ROWS_SINCE):
        return None
    return {"type": "tool_use", "id": "toolu_cs_" + uuid.uuid4().hex, "name": tool_name, "input": args}


def claude_messages(message, cwd, version):
    """Emit complete Claude tool exchanges. Parallel calls share an assistant
    message; their results follow in original completion order. Never leave a
    pending tool request at the end of history for the next engine to run."""
    tools = message.get("tools", {})
    pairs = {}
    for call, result in matched_tools(tools):
        use = claude_tool_use(tools[call], cwd, version)
        if use is not None:
            pairs[call] = (result, use)
    if not pairs:
        yield message["role"], message["text"], {}
        return
    results = {result for result, _ in pairs.values()}
    parts = message["parts"]
    index = 0
    prose = []
    while index < len(parts):
        if index not in pairs:
            if index not in results:
                prose.append(parts[index])
            elif prose:
                # A result's part opens with the line closing a block the prose
                # left open (History.add); without it, the prose ends here.
                yield "assistant", "\n\n".join(prose), {}
                prose = []
            index += 1
            continue
        if prose:
            yield "assistant", "\n\n".join(prose), {}
            prose = []
        # Claude displays one tool row per assistant record. Its parallel
        # tool blocks share the API message ID, each with its own record UUID
        # for sourceToolAssistantUUID on the corresponding result.
        batch = []
        request_id = "req_cs_" + uuid.uuid4().hex
        while index in pairs:
            result, use = pairs[index]
            assistant_id = str(uuid.uuid4())
            failed = tools[result]["failed"]
            batch.append((result, use, failed, assistant_id))
            yield "assistant", [use], {"uuid": assistant_id, "requestId": request_id}
            index += 1
        for result, use, failed, assistant_id in sorted(batch, key=lambda entry: entry[0]):
            output = REMINDER_TAG.sub("&lt;", tools[result]["output"])
            if failed:
                # Claude's detailed transcript can render only the error line
                # for a failed tool, even when a parallel call succeeded.
                output = "[" + use["name"] + "] " + output
            block = {"type": "tool_result", "tool_use_id": use["id"], "content": output, "is_error": failed}
            detail = ({"stdout": output, "stderr": "", "interrupted": False, "isImage": False,
                       "noOutputExpected": False} if use["name"] == "Bash" and not failed else output)
            yield "user", [block], {"sourceToolAssistantUUID": assistant_id, "toolUseResult": detail}
    if prose:
        yield "assistant", "\n\n".join(prose), {}


def claude_transcript(messages, session_id, cwd, version, branch, note):
    messages = list(messages)
    if messages and messages[0]["role"] == "user":
        messages[0] = dict(messages[0], text=note + "\n\n" + messages[0]["text"])
    else:
        messages.insert(0, {"role": "user", "text": note, "timestamp": None})
    now = time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime())
    lines, parent = [], None
    for message in messages:
        for role, content, extra in claude_messages(message, cwd, version):
            record_id = extra.get("uuid") or str(uuid.uuid4())
            record = {"parentUuid": parent, "isSidechain": False, "userType": "external", "cwd": cwd,
                      "sessionId": session_id, "version": version, "gitBranch": branch,
                      **extra, "type": role, "uuid": record_id, "timestamp": message["timestamp"] or now}
            if role == "user":
                record["message"] = {"role": "user", "content": content}
            else:
                request_id = extra.get("requestId") or "req_cs_" + uuid.uuid4().hex
                record["requestId"] = request_id
                record["message"] = {
                    "id": "msg_" + request_id[4:], "type": "message", "role": "assistant",
                    "model": CARRIED_MODEL,
                    "content": content if isinstance(content, list) else [{"type": "text", "text": content}],
                    "stop_reason": "tool_use" if isinstance(content, list) else "end_turn", "stop_sequence": None,
                    "usage": {"input_tokens": 0, "output_tokens": 0,
                              "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0},
                }
            lines.append(json.dumps(record, ensure_ascii=False, separators=(",", ":")))
            parent = record_id
    return "\n".join(lines) + "\n"


def export_claude(args):
    # A Codex thread written out as a Claude Code transcript that
    # `claude --resume <session id>` continues. Prints what it carried.
    messages = read_codex(codex_rollout(args.thread_id), args.clip)
    if messages:
        cwd = str(Path(args.cwd).resolve(strict=True))
        note = carried_note("codex", args.thread_id, args.clip)
        # An unpaired escape, in a rollout line or in a command result decoded again, is a lone
        # surrogate once decoded; the transcript is strict UTF-8.
        write_private(args.out, LONE_SURROGATE.sub("\ufffd", claude_transcript(
            messages, args.session_id, cwd, args.claude_version or DEFAULT_CLAUDE_VERSION,
            args.git_branch or "", note)))
    return history_stats(messages)


def read_claude_stats(args):
    return history_stats(read_claude(args.read_claude, args.clip))


def model_message(role, text):
    content = "output_text" if role == "assistant" else "input_text"
    return {"type": "message", "role": role, "content": [{"type": content, "text": text}]}


def native_arguments(value, depth=0):
    # Codex's JSON reader has nesting and number limits. Use the existing
    # text fallback for inputs that would be rejected or rounded on replay.
    if isinstance(value, (dict, list)):
        children = value.values() if isinstance(value, dict) else value
        return depth < READABLE_DEPTH and all(native_arguments(v, depth + 1) for v in children)
    if isinstance(value, int):
        return -(2**63) <= value < 2**64
    return not isinstance(value, float) or math.isfinite(value)


def native_tool_item(call, result, cwd):
    """A paired Claude call as a native Codex row, spelled as Codex's rollout stores it on disk:
    PascalCase item types, snake_case aggregated_output, exit_code and parsed_cmd, and cwd as a
    file:// URI, not the app-server's camelCase that same_display_item reads back.
    Measured on Codex 0.169.0-alpha.11.1; CI runs the real-Codex cases on its pinned Codex."""
    name, args = call["name"], call["input"]
    status = "failed" if result["failed"] else "completed"
    item_id = str(uuid.uuid4())
    if name == "Bash" and isinstance(args, dict) and isinstance(args.get("command"), str):
        command = args["command"]
        directory = call["cwd"]
        if not isinstance(directory, str) or not Path(directory).is_absolute():
            directory = cwd
        return {"type": "CommandExecution", "id": item_id, "command": ["bash", "-lc", command],
                "cwd": Path(directory).as_uri(), "source": "agent", "status": status,
                "parsed_cmd": [{"type": "unknown", "cmd": command}], "aggregated_output": result["output"],
                "exit_code": result["exit_code"]}
    # Keep Claude's built-ins identifiable and restore MCP tools' actual server and tool names.
    server = "claude"
    name = name if isinstance(name, str) and name else "tool"
    if name.startswith("mcp__"):
        parts = name.split("__", 2)
        if len(parts) == 3 and parts[1] and parts[2]:
            server, name = parts[1:]
    if not native_arguments(args):
        return None
    return {"type": "McpToolCall", "id": item_id, "server": server, "tool": name, "arguments": args,
            "status": status, "result": {"content": [{"type": "text", "text": result["output"]}],
                                         "isError": result["failed"]}}


def display_items(message, cwd, native=True):
    if message["role"] == "user":
        yield {"type": "UserMessage", "id": str(uuid.uuid4()), "client_id": None,
               "content": [{"type": "text", "text": message["text"], "text_elements": []}]}
        return
    # Without native rows every part is prose: one reply holding the model's text.
    tools = message.get("tools", {}) if native else {}
    rows, consumed = {}, set()
    for call, result in matched_tools(tools):
        row = native_tool_item(tools[call], tools[result], cwd)
        if row is not None:
            rows[call] = row
            consumed.add(result)

    def reply(parts, phase):
        return {"type": "AgentMessage", "id": str(uuid.uuid4()), "phase": phase,
                "content": [{"type": "Text", "text": "\n\n".join(parts)}]}

    prose = []
    for index, part in enumerate(message.get("parts", [message["text"]])):
        if index in rows:
            if prose:
                yield reply(prose, "commentary")
                prose = []
            yield rows[index]
        elif index not in consumed:
            prose.append(part)
        elif prose:
            # The result's part may hold the line closing a block the prose left open.
            yield reply(prose, "commentary")
            prose = []
    if prose:
        yield reply(prose, "final_answer")


def carried_records(thread_id, messages, cwd, native=True):
    """Put one model message and its display items inside the same revertible turn."""
    turn = None
    last_reply = None
    imported_at = int(time.time())

    def finished():
        return {"type": "task_complete", "turn_id": turn, "root_turn_id": turn,
                "last_agent_message": last_reply, "started_at": imported_at, "completed_at": imported_at,
                "duration_ms": 0, "time_to_first_token_ms": 0}

    for message in messages:
        if turn is None or message["role"] == "user":
            if turn is not None:
                yield "event_msg", finished()
            turn, last_reply = str(uuid.uuid4()), None
            yield "event_msg", {
                "type": "task_started", "turn_id": turn, "root_turn_id": turn,
                "turn_attribution": {"turn_id": turn, "root_turn_id": turn,
                                        "turn_trigger": "user", "parent_turn_id": None,
                                        "initiating_agent_path": None},
                "started_at": imported_at, "model_context_window": 0, "collaboration_mode_kind": "default"}
        model = model_message(message["role"], message["text"])
        model["id"] = "msg_" + str(uuid.uuid4())
        yield "response_item", model
        for item in display_items(message, cwd, native):
            last_reply = item["content"][0]["text"] if item["type"] == "AgentMessage" else None
            yield "event_msg", {"type": "item_completed", "thread_id": thread_id, "turn_id": turn,
                                "item": item, "started_at_ms": imported_at * 1000, "completed_at_ms": imported_at * 1000}
    if turn is not None:
        yield "event_msg", finished()


def persist_carried_display(rollout_path, thread_id, messages, cwd, native=True):
    # Only a newly created, not-yet-bound thread is eligible. Its sole writer
    # has exited before we open it, and the verification server has not yet
    # indexed it. Never use this to patch a running or already indexed thread.
    home = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex").resolve()
    if not isinstance(rollout_path, str):
        raise BootstrapError("Codex did not return the new thread's rollout path")
    path = Path(rollout_path)
    if (path.is_symlink() or path.suffix != '.jsonl'
            or home / 'sessions' not in path.resolve().parents):
        raise BootstrapError("Codex returned an unsafe carry-over rollout path")
    fd = os.open(str(path), os.O_RDWR | os.O_APPEND | os.O_NOFOLLOW)
    with os.fdopen(fd, 'r+', encoding='utf-8') as handle:
        if not stat.S_ISREG(os.fstat(handle.fileno()).st_mode):
            raise BootstrapError("Carry-over rollout is not a regular file")
        ordinal, matched = -1, False
        try:
            for line in handle:
                if not line.endswith('\n'):
                    raise ValueError()
                record = json.loads(line)
                if not isinstance(record, dict):
                    raise ValueError()
                payload = record.get('payload', {})
                if record.get('type') == 'session_meta':
                    if matched or payload.get('id') != thread_id:
                        raise ValueError()
                    matched = True
                if record.get('type') == 'event_msg' and payload.get('type') in (
                        'task_started', 'item_completed', 'task_complete'):
                    raise BootstrapError("Carry-over rollout already contains conversation turns")
                value = record.get('ordinal')
                if type(value) is not int or value <= ordinal:
                    raise ValueError()
                ordinal = value
        except (ValueError, AttributeError) as exc:
            raise BootstrapError("Codex carry-over rollout has an unsupported format") from exc
        if not matched:
            raise BootstrapError("Carry-over rollout does not identify the new thread")
        timestamp = datetime.datetime.now(datetime.timezone.utc).isoformat()
        expected = []
        handle.seek(0, os.SEEK_END)
        for kind, payload in carried_records(thread_id, messages, cwd, native):
            ordinal += 1
            if payload["type"] == "item_completed":
                expected.append((payload["turn_id"], payload["item"]))
            handle.write(json.dumps({"timestamp": timestamp, "ordinal": ordinal,
                                     "type": kind, "payload": payload}) + '\n')
        handle.flush()
        os.fsync(handle.fileno())
    return expected


def same_display_item(saved, item):
    kind = saved["type"]
    if item.get("type") != kind[0].lower() + kind[1:] or item.get("id") != saved["id"]:
        return False
    if kind == "AgentMessage":
        return item.get("text") == saved["content"][0]["text"]
    if kind == "UserMessage":
        return item.get("content") == saved["content"]
    if item.get("status") != saved["status"]:
        return False
    if kind == "CommandExecution":
        # Codex 0.169 hands back null for an empty output.
        return ((item.get("aggregatedOutput") or "") == saved["aggregated_output"] and
                item.get("exitCode") == saved["exit_code"] and
                item.get("commandActions") == [{"type": "unknown", "command": saved["command"][-1]}])
    result = item.get("result")
    return (all(item.get(k) == saved[k] for k in ("server", "tool", "arguments"))
            and isinstance(result, dict) and result.get("content") == saved["result"]["content"])


def verify_carried_display(server, thread_id, expected):
    # Page through a new server as a native resume does. Batch small rows:
    # a long Claude reply can contain hundreds of calls. An oversized row
    # gets a page to itself and an allowance based on its serialized size.
    cursor, cursors, index = None, set(), 0
    while True:
        count, text_size = 0, 0
        for _, saved in expected[index:index + 32]:
            size = len(json.dumps(saved))
            if saved["type"] == "CommandExecution":
                # The API also shell-quotes the command to build its display string.
                size += 4 * len(saved["command"][-1])
            if count and text_size + size > MAX_MESSAGE // 4:
                break
            text_size += size
            count += 1
        params = {'threadId': thread_id, 'sortDirection': 'asc', 'limit': max(1, count)}
        if cursor is not None:
            params['cursor'] = cursor
        result = server.request('thread/items/list', params, max_message=MAX_MESSAGE + text_size)
        data = result.get('data')
        if not isinstance(data, list) or any(not isinstance(t, dict) for t in data):
            raise BootstrapError("Codex could not verify the carried transcript's display")
        for entry in data:
            item = entry.get('item', {})
            if not isinstance(item, dict) or index >= len(expected):
                raise DisplayMismatch("Codex returned unexpected carried transcript items")
            turn_id, saved = expected[index]
            if entry.get("turnId") != turn_id or not same_display_item(saved, item):
                raise DisplayMismatch("Codex did not retain the carried transcript's visible messages")
            index += 1
        cursor = result.get('nextCursor')
        if cursor is None:
            break
        if not isinstance(cursor, str) or cursor in cursors or not data:
            raise BootstrapError("Codex returned invalid carry-over pagination")
        cursors.add(cursor)
    if index != len(expected):
        raise DisplayMismatch("Codex did not retain the carried transcript's visible turns and messages")


def bootstrap(args):
    # Codex refuses a CODEX_HOME that does not exist; name it rather than
    # starting a server whose explanation would stay private.
    codex_home = os.environ.get("CODEX_HOME")
    if codex_home and not Path(codex_home).is_dir():
        raise BootstrapError(
            "CODEX_HOME points to " + codex_home + ", which does not exist; create it, then run codex login"
        )
    cwd = str(Path(args.cwd).resolve(strict=True))
    if not Path(cwd).is_dir():
        raise BootstrapError("cwd must be an existing directory")
    instructions = Path(args.instructions_file).read_text(encoding="utf-8")
    if not instructions.strip():
        raise BootstrapError("instructions file must not be empty")
    if len(instructions.encode("utf-8")) > MAX_MESSAGE // 2:
        raise BootstrapError("instructions file is too large")
    # Read before any server starts, so an unreadable conversation creates no thread.
    messages, provenance = [], None
    if args.history_from_claude:
        messages = read_claude(args.history_from_claude, args.clip)
        if not messages:
            raise BootstrapError("the Claude conversation has nothing to carry over")
        source = args.history_source or Path(args.history_from_claude).stem
        provenance = model_message("developer", carried_note("claude", source, args.clip))
    thread_id = prepare_thread(args, cwd, instructions, messages, provenance, True, time.monotonic() + args.timeout)
    if thread_id is None:
        # Codex did not show the native tool rows back and that thread is gone: carry
        # the conversation again with its tool calls as reply text, as carries showed before native rows.
        print("cs-codex-thread: Codex did not keep the carried tool rows; carrying the tool calls as text instead",
              file=sys.stderr)
        thread_id = prepare_thread(args, cwd, instructions, messages, provenance, False,
                                   time.monotonic() + args.timeout)
    return thread_id


def prepare_thread(args, cwd, instructions, messages, provenance, native, deadline):
    """Start or resume the thread, carry messages into it and check what a fresh server shows.
    None means a carry with native tool rows failed that check, and its new thread was deleted."""
    with AppServer(args.codex_bin, cwd, deadline) as server:
        server.initialize()
        if args.thread_id:
            # Only identity is needed here; full history can exceed MAX_MESSAGE.
            result = server.request("thread/resume", {
                "threadId": args.thread_id, "cwd": cwd, "excludeTurns": True,
            })
        else:
            result = server.request("thread/start", {"cwd": cwd, "ephemeral": False})
        thread_id = exact_id(result, args.thread_id)
        rollout_path = result['thread'].get('path')
        # thread/start alone is lazy: its returned path may not exist on disk.
        # Appending developer context materializes history without a user turn.
        # Do not override developerInstructions: preserve the user's configuration.
        server.request("thread/inject_items", {
            "threadId": thread_id,
            "items": [{"type": "message", "role": "developer", "content": [
                {"type": "input_text", "text": instructions},
            ]}],
        })
        # Only the provenance note belongs outside turns. The conversation
        # is persisted with its display events after this writer has exited,
        # so native revert removes both views at the same turn boundary.
        if messages:
            server.request("thread/inject_items", {"threadId": thread_id, "items": [provenance]})
        server.request("thread/unsubscribe", {"threadId": thread_id})
    visible_items = persist_carried_display(rollout_path, thread_id, messages, cwd, native) if messages else []
    # A successful start/injection response is insufficient proof of durability.
    with AppServer(args.codex_bin, cwd, deadline) as server:
        server.initialize()
        exact_id(server.request("thread/resume", {
            "threadId": thread_id, "cwd": cwd, "excludeTurns": True,
        }), thread_id)
        if visible_items:
            try:
                verify_carried_display(server, thread_id, visible_items)
            except DisplayMismatch:
                # Only a row Codex changed: a check that ran out of time, lost its server or broke
                # the protocol fails as it did, and a deadline that passed would refuse thread/delete.
                if not any(item["type"] in ("CommandExecution", "McpToolCall") for _, item in visible_items):
                    raise
                try:
                    server.request("thread/delete", {"threadId": thread_id})
                except BootstrapError:
                    pass  # A failed carry left its thread behind before; a refused delete does no worse.
                return None
        server.request("thread/unsubscribe", {"threadId": thread_id})
    return thread_id


def latest_turn(args):
    # The thread's persisted history, read without loading the thread: the
    # newest turn's ID, or "" for a thread no turn has started in. A turn is
    # recorded as it starts, so one a crashed or killed CLI left is here too.
    codex_home = os.environ.get("CODEX_HOME")
    if codex_home and not Path(codex_home).is_dir():
        raise BootstrapError("CODEX_HOME points to " + codex_home + ", which does not exist")
    cwd = str(Path(args.cwd).resolve(strict=True))
    with AppServer(args.codex_bin, cwd, time.monotonic() + args.timeout) as server:
        server.initialize()
        result = server.request("thread/turns/list", {
            "threadId": args.thread_id, "limit": 1, "sortDirection": "desc", "itemsView": "notLoaded",
        })
    turns = result.get("data")
    if not isinstance(turns, list):
        raise BootstrapError("codex app-server returned an invalid thread/turns/list response")
    if not turns:
        return ""
    value = turns[0].get("id") if isinstance(turns[0], dict) else None
    if not isinstance(value, str) or not TURN_ID.fullmatch(value):
        raise BootstrapError("codex app-server did not return an exact turn ID")
    return value


def project_config(args):
    # The model settings a trusted project's .codex/config.toml supplies, as
    # Codex itself resolves them from cwd: they outrank a --profile.
    codex_home = os.environ.get("CODEX_HOME")
    if codex_home and not Path(codex_home).is_dir():
        raise BootstrapError("CODEX_HOME points to " + codex_home + ", which does not exist")
    cwd = str(Path(args.cwd).resolve(strict=True))
    with AppServer(args.codex_bin, cwd, time.monotonic() + args.timeout) as server:
        server.initialize()
        result = server.request("config/read", {"cwd": cwd, "includeLayers": False})
    config, origins = result.get("config"), result.get("origins")
    if not isinstance(config, dict) or not isinstance(origins, dict):
        raise BootstrapError("codex app-server returned an invalid config/read response")
    pinned = {}
    for key in ("model", "model_reasoning_effort"):
        origin = origins.get(key)
        layer = origin.get("name") if isinstance(origin, dict) else None
        if not isinstance(layer, dict) or layer.get("type") != "project":
            continue
        value, folder = config.get(key), layer.get("dotCodexFolder")
        if isinstance(value, str) and isinstance(folder, str):
            pinned[key] = {"value": value, "file": os.path.join(folder, "config.toml")}
    return json.dumps(pinned)


# An encrypted session runs Codex on a home inside its vault (lib/76-codex-vault.sh).
# cs's permissions profile there keeps the agent from writing that home.
VAULT_PROFILE = "cs-vault-home"


def has_thread(args):
    # Whether CODEX_HOME keeps this thread's history: a binding made before the
    # session's Codex home moved into its vault names a thread kept elsewhere.
    try:
        codex_rollout(args.thread_id)
    except BootstrapError:
        return "no"
    return "yes"


def load_toml(text, what):
    try:
        import tomllib
    except ImportError as exc:
        raise BootstrapError("reading " + what + " needs Python 3.11 or later (tomllib)") from exc
    try:
        return tomllib.loads(text)
    except tomllib.TOMLDecodeError as exc:
        raise BootstrapError(what + " is not valid TOML") from exc


def trust_sources(home):
    # The paths Codex keys a home's hook trust by: the home's hooks.json and
    # config.toml ([[hooks.<event>]] tables), as the home is spelled and as it resolves.
    spellings = []
    for base in (str(home), os.path.realpath(home)):
        for name in ("hooks.json", "config.toml"):
            path = os.path.join(base, name)
            if path not in spellings:
                spellings.append(path)
    return spellings


def plain_path(path):
    # Kept out of the re-keyed TOML keys: a quote or a backslash would need escaping there.
    return '"' not in path and "\\" not in path and "\n" not in path


def seed_config(args):
    # The vault home's config.toml and rules/: copies of the shared home's, made
    # at every launch, so the user's later edits reach them and what a run saves
    # in them (an approval Codex appends to rules/, a project trust) lasts until
    # the next open. Codex keys hook trust by the path of the hooks.json or
    # config.toml it read the hook from, so each trust table the shared home
    # holds is renamed to the vault home's path: the hooks are the same file
    # (hooks.json is a link) or the same text (config.toml), and every
    # trusted_hash is bound to the hook's content. Nothing else is changed and
    # nothing is taken from the previous copy, which a writer outside Codex's
    # sandbox may have edited.
    shared, home = Path(args.shared_home), Path(args.home)
    if not home.is_dir() or home.is_symlink():
        raise BootstrapError("the vault Codex home is not a directory: " + str(home))
    new_base = str(home)
    if not plain_path(new_base):
        raise BootstrapError("the vault Codex home's path holds a quote or a backslash")
    source = shared / "config.toml"
    text = source.read_text(encoding="utf-8") if source.is_file() else ""
    load_toml(text, str(source))
    renames = [(old, os.path.join(new_base, os.path.basename(old)))
               for old in trust_sources(shared) if plain_path(old)]
    lines = []
    for line in text.splitlines(keepends=True):
        body = line.lstrip()
        for old, new in renames:
            prefix = '[hooks.state."' + old + ":"
            if body.startswith(prefix):
                line = line[:len(line) - len(body)] + '[hooks.state."' + new + ":" + body[len(prefix):]
                break
        lines.append(line)
    seeded = "".join(lines)
    # An entry the text pass did not re-key (another TOML form, written by hand)
    # stays keyed by the shared home and its hook would not run here: say how
    # to write it, before the previous copy is replaced.
    state = load_toml(seeded, str(source)).get("hooks")
    state = state.get("state") if isinstance(state, dict) else None
    for key in (state if isinstance(state, dict) else ()):
        if any(key.startswith(old + ":") for old, _ in renames):
            raise BootstrapError(
                "cs cannot re-key the hook trust entry " + json.dumps(key) + " in " + str(source)
                + " for the vault Codex home: it re-keys only [hooks.state.\"<key>\"] tables, so write"
                + " the entry as [hooks.state." + json.dumps(key) + "] there")
    target = home / "config.toml"
    handle, temp = tempfile.mkstemp(prefix=".config.toml.", dir=str(home))
    try:
        with os.fdopen(handle, "w", encoding="utf-8") as out:
            out.write(seeded)
        os.chmod(temp, 0o600)
        os.replace(temp, target)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(temp)
        raise
    seed_rules(shared, home)
    return str(target)


def dangling_links(directory, names):
    # copytree's own ignore_dangling_symlinks tests a relative link from the
    # current directory, not from the link's, and so drops a sound one.
    return {name for name in names
            if os.path.islink(os.path.join(directory, name)) and not os.path.exists(os.path.join(directory, name))}


def seed_rules(shared, home):
    # rules/ is copied whole, links in the shared one followed and dangling ones
    # left out, so nothing in the copy points back into the shared home. An
    # earlier open's link to the shared rules/ is removed; the previous copy is
    # replaced only once the new one is complete.
    target = home / "rules"
    if target.is_symlink():
        target.unlink()
    elif target.exists() and not target.is_dir():
        # Shown as cs shows a plain name: the vault home is reached through .cs/private, a link.
        shown = re.sub(r"[^A-Za-z0-9._/@-]", "_", str(target))
        raise BootstrapError("the vault Codex home's rules is not a directory: " + shown)
    source = shared / "rules"
    fresh = tempfile.mkdtemp(prefix=".rules.", dir=str(home))
    aside = None
    try:
        if source.is_dir():
            shutil.copytree(str(source), fresh, symlinks=False, ignore=dangling_links, dirs_exist_ok=True)
        os.chmod(fresh, 0o700)
        if target.is_dir():
            # Renamed over an empty directory of its own, which rename allows.
            aside = tempfile.mkdtemp(prefix=".rules.", dir=str(home))
            os.rename(str(target), aside)
        try:
            os.rename(fresh, str(target))
        except BaseException:
            if aside is not None:
                os.rename(aside, str(target))
                aside = None
            raise
    except BaseException as exc:
        shutil.rmtree(fresh, ignore_errors=True)
        if isinstance(exc, OSError):
            raise BootstrapError("could not copy " + str(source) + " into the vault Codex home") from exc
        raise
    if aside is not None:
        shutil.rmtree(aside, ignore_errors=True)


def defines_hooks(source, shared):
    # Whether a trust source of the shared home still defines a hook, as Codex
    # loads them: a hooks.json whose "hooks" object, or the config.toml (parsed
    # in shared) whose [hooks] table, its state aside, names an event with a
    # matcher group. Codex loads nothing from a hooks.json it cannot read or parse.
    if os.path.basename(source) == "hooks.json":
        try:
            data = json.loads(Path(source).read_text(encoding="utf-8"))
        except (OSError, UnicodeError, ValueError):
            return False
        events = data.get("hooks") if isinstance(data, dict) else None
    else:
        events = shared.get("hooks")
        events = {name: groups for name, groups in events.items() if name != "state"} \
            if isinstance(events, dict) else None
    return isinstance(events, dict) and any(events.values())


def vault_check(args):
    # What the launch needs before it starts Codex on a vault home (CODEX_HOME):
    # the sandbox settings Codex resolves for the session from its files (the
    # command line adds cs's profile on top), whether a file already defines a
    # profile under cs's name, and the hooks trusted in the shared home that are
    # not trusted here: the shared config.toml's own trust tables decide which
    # those are, so a table the copy missed is found whatever its TOML form.
    # A source the vault lists no hook of at all is named apart, in unlisted.
    # So is each project config.toml Codex reads but leaves out until the folder
    # is trusted, in untrusted_project_configs: answering Codex's trust question
    # loads it after cs has chosen its profile from what config/read said.
    codex_home = os.environ.get("CODEX_HOME")
    if not codex_home or not Path(codex_home).is_dir():
        raise BootstrapError("--vault-check needs CODEX_HOME set to the vault Codex home")
    cwd = str(Path(args.cwd).resolve(strict=True))
    shared_config = Path(args.shared_home) / "config.toml"
    shared = load_toml(shared_config.read_text(encoding="utf-8"), str(shared_config)) \
        if shared_config.is_file() else {}
    with AppServer(args.codex_bin, cwd, time.monotonic() + args.timeout) as server:
        server.initialize()
        result = server.request("config/read", {"cwd": cwd, "includeLayers": True})
        listed = server.request("hooks/list", {"cwds": [cwd]})
    config, layers = result.get("config"), result.get("layers")
    if not isinstance(config, dict) or not isinstance(layers, list):
        raise BootstrapError("codex app-server returned an invalid config/read response")
    # Codex keeps a project layer it does not trust, disabled (disabledReason
    # set), out of the config it resolves. One with no config.toml behind it
    # has nothing for Codex to load once the folder is trusted.
    untrusted_project_configs = []
    for layer in layers:
        source = layer.get("name") if isinstance(layer, dict) else None
        if not isinstance(source, dict) or source.get("type") != "project" \
                or layer.get("disabledReason") is None or not isinstance(source.get("dotCodexFolder"), str):
            continue
        project_file = os.path.join(source["dotCodexFolder"], "config.toml")
        if os.path.isfile(project_file) and project_file not in untrusted_project_configs:
            untrusted_project_configs.append(project_file)
    hooks = {}
    for entry in listed.get("data") or []:
        for hook in (entry.get("hooks") if isinstance(entry, dict) else None) or []:
            if isinstance(hook, dict) and isinstance(hook.get("key"), str):
                hooks[hook["key"]] = hook
    state = shared.get("hooks", {}).get("state") if isinstance(shared.get("hooks"), dict) else None
    state = state if isinstance(state, dict) else {}
    untrusted = []
    unlisted = []
    for old in trust_sources(Path(args.shared_home)):
        new = os.path.join(codex_home, os.path.basename(old))
        trusted = {key: value for key, value in state.items()
                   if key.startswith(old + ":") and isinstance(value, dict)
                   and isinstance(value.get("trusted_hash"), str)}
        # The vault lists no hook of a source the shared home still defines
        # hooks in: Codex lists or keys them in a way cs did not re-key for,
        # and every hook trusted there would stop running without a word.
        # Trusting them again in /hooks cannot change that, so the source is
        # named apart from the hooks the vault lists untrusted.
        if trusted and not any(key.startswith(new + ":") for key in hooks) \
                and defines_hooks(old, shared):
            unlisted.append(old)
            continue
        for key, value in trusted.items():
            hook = hooks.get(new + key[len(old):])
            # Beside hooks of the same source the vault does list, a trust the
            # shared home keeps for content that changed since, or for a hook
            # no longer there, trusts nothing anywhere.
            if hook is None or hook.get("currentHash") != value.get("trusted_hash"):
                continue
            if hook.get("trustStatus") != "trusted":
                untrusted.append(str(hook.get("command") or key))
    sandbox = config.get("sandbox_workspace_write")
    sandbox = sandbox if isinstance(sandbox, dict) else {}
    # cs's profile carries each writable root as a write entry beside the home's
    # read one, and Codex lets a write at or under a path win over its read: such
    # a root would undo the read-only home, so the launch refuses it.
    real_home = os.path.realpath(codex_home)
    roots = sandbox.get("writable_roots")
    home_roots = []
    for root in (roots if isinstance(roots, list) else ()):
        real = os.path.realpath(root) if isinstance(root, str) else None
        if real is not None and (real == real_home or real.startswith(real_home + os.sep)):
            home_roots.append(root)
    permissions = config.get("permissions")
    return json.dumps({
        "sandbox_mode": config.get("sandbox_mode"),
        "default_permissions": config.get("default_permissions"),
        "sandbox_workspace_write": sandbox,
        "profile_defined": isinstance(permissions, dict) and VAULT_PROFILE in permissions,
        "untrusted": untrusted,
        "unlisted": unlisted,
        "home_roots": home_roots,
        "untrusted_project_configs": untrusted_project_configs,
    })


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--codex-bin")
    parser.add_argument("--cwd")
    parser.add_argument("--instructions-file")
    parser.add_argument("--thread-id")
    parser.add_argument("--latest-turn", action="store_true",
                        help="print the thread's newest turn ID (empty for none) and change nothing")
    parser.add_argument("--project-config", action="store_true",
                        help="print, as JSON, the model settings a project layer sets for --cwd")
    parser.add_argument("--has-thread", action="store_true",
                        help="print yes when CODEX_HOME keeps --thread-id's history, else no")
    parser.add_argument("--queue-snapshot", metavar="ROLLOUT",
                        help="read the active rollout for a queue Stop hook")
    parser.add_argument("--queue-turn")
    parser.add_argument("--queue-receipt")
    parser.add_argument("--queue-offset", type=int, metavar="BYTES",
                        help="read the rollout from the current task's delivery, not its last 8 MiB")
    parser.add_argument("--seed-config", action="store_true",
                        help="copy --shared-home's config.toml and rules/ into --home, the config's hook trust re-keyed")
    parser.add_argument("--vault-check", action="store_true",
                        help="print, as JSON, the sandbox settings and untrusted hooks of the vault home in CODEX_HOME")
    parser.add_argument("--shared-home")
    parser.add_argument("--home")
    parser.add_argument("--export-claude", action="store_true",
                        help="write --thread-id's saved history to --out as a Claude transcript for --session-id")
    parser.add_argument("--read-claude", metavar="TRANSCRIPT",
                        help="print, as JSON, what a Claude transcript would carry into a thread")
    parser.add_argument("--history-from-claude", metavar="TRANSCRIPT",
                        help="carry a Claude transcript into the new thread, after the instructions")
    parser.add_argument("--history-source", help="the Claude conversation ID the carried note names")
    parser.add_argument("--session-id")
    parser.add_argument("--out")
    parser.add_argument("--claude-version")
    parser.add_argument("--git-branch")
    parser.add_argument("--clip", type=int, default=DEFAULT_CLIP,
                        help="characters of each tool result to carry (default %(default)s)")
    parser.add_argument("--timeout", type=float, default=30)
    args = parser.parse_args()
    if not math.isfinite(args.timeout) or not 0 < args.timeout <= 300:
        parser.error("--timeout must be between 0 and 300 seconds")
    if args.clip < 1:
        parser.error("--clip must be a positive number of characters")
    if args.thread_id is not None and not THREAD_ID.fullmatch(args.thread_id):
        parser.error("--thread-id must be an exact Codex UUID")
    if args.export_claude:
        if args.thread_id is None or args.out is None or args.cwd is None:
            parser.error("--export-claude needs --thread-id, --cwd and --out")
        if args.session_id is None or not THREAD_ID.fullmatch(args.session_id):
            parser.error("--export-claude needs --session-id, a UUID")
    elif args.read_claude is not None:
        if args.thread_id is not None or args.latest_turn or args.project_config:
            parser.error("--read-claude reads no thread")
    elif args.has_thread:
        if args.thread_id is None:
            parser.error("--has-thread needs --thread-id")
    elif args.queue_snapshot is not None:
        if args.thread_id is None or not THREAD_ID.fullmatch(args.queue_turn or ""):
            parser.error("--queue-snapshot needs --thread-id and --queue-turn")
        if args.queue_offset is not None and args.queue_offset < 0:
            parser.error("--queue-offset must not be negative")
    elif args.seed_config:
        if args.shared_home is None or args.home is None or args.cwd is None:
            parser.error("--seed-config needs --shared-home, --home and --cwd")
    elif args.vault_check:
        if args.codex_bin is None or args.cwd is None or args.shared_home is None:
            parser.error("--vault-check needs --codex-bin, --cwd and --shared-home")
    else:
        if args.codex_bin is None or args.cwd is None:
            parser.error("--codex-bin and --cwd are required")
        if args.latest_turn and args.thread_id is None:
            parser.error("--latest-turn needs --thread-id")
        if args.project_config and (args.latest_turn or args.thread_id is not None):
            parser.error("--project-config reads no thread")
        if not args.latest_turn and not args.project_config and args.instructions_file is None:
            parser.error("--instructions-file is required")
        if args.history_from_claude is not None and (
                args.thread_id is not None or args.latest_turn or args.project_config):
            parser.error("--history-from-claude starts a new thread")

    def interrupted(_signum, _frame):
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, interrupted)
    try:
        if args.export_claude:
            printed = export_claude(args)
        elif args.read_claude is not None:
            printed = read_claude_stats(args)
        elif args.project_config:
            printed = project_config(args)
        elif args.has_thread:
            printed = has_thread(args)
        elif args.queue_snapshot is not None:
            printed = queue_snapshot(args)
        elif args.seed_config:
            printed = seed_config(args)
        elif args.vault_check:
            printed = vault_check(args)
        else:
            printed = latest_turn(args) if args.latest_turn else bootstrap(args)
    except KeyboardInterrupt:
        print("cs-codex-thread: interrupted", file=sys.stderr)
        return 130
    except (BootstrapError, OSError, UnicodeError) as exc:
        # File and process errors may contain paths or server text; keep them private.
        message = str(exc) if isinstance(exc, BootstrapError) else (
            "could not read the thread's turns" if args.latest_turn
            else "could not read the project's configuration" if args.project_config or args.vault_check
            else "could not write the vault Codex home's config.toml" if args.seed_config
            else "could not look for the thread's history" if args.has_thread
            else "could not read the active rollout" if args.queue_snapshot is not None
            else "could not write the Claude transcript" if args.export_claude
            else "could not read the Claude transcript" if args.read_claude is not None
            else "could not read bootstrap inputs")
        print("cs-codex-thread: " + message, file=sys.stderr)
        return 1
    print(printed)
    return 0


if __name__ == "__main__":
    sys.exit(main())
